    "voicelines": [
        {
            "type": "card_get",
            "text": "Let's be together forever and ever! I love you all so much!",
            "audio": "resources/vo_live_dial_card_00030_00030-5-uniq-0024-00_myself.acb/vo_live_dial_card_00030_00030-5-uniq-0024-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "I went through all the trouble of dressing up, you know! What are you doing?\nYou’re leaving me all by myself? I’m gonna start pouting now, you know~!\nEeeeh? Is that...a daifuku snowman!!\nIt’s so small and cute~♪ Did you make it for me? Aww~ ♡ You’re so sweet ♡\nHere’s your reward! A kiss from yours truly! ♡",
            "audio": "resources/vo_card_cmn_00030_00030-5-uniq-0024-00_situation.acb/vo_card_cmn_00030_00030-5-uniq-0024-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "LOVE LOVE! Kiss, kiss!",
            "audio": "resources/vo_live_cmn_card_00030_00030-5-uniq-0024-00_skill-card.acb/vo_live_cmn_card_00030_00030-5-uniq-0024-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "This dress is designed with snowflakes as the motif. Perfect for me, right?",
            "audio": "resources/vo_card_cmn_00030_00030-5-uniq-0024-00_potential-001.acb/vo_card_cmn_00030_00030-5-uniq-0024-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "You said that I look cute today... WRONG! I'm cute EVERYDAY! Geez...",
            "audio": "resources/vo_card_cmn_00030_00030-5-uniq-0024-00_potential-002.acb/vo_card_cmn_00030_00030-5-uniq-0024-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Hey, hey ♪ Don’t just look at the illuminations, look at me too ♪",
            "audio": "resources/vo_card_cmn_00030_00030-5-uniq-0024-00_potential-003.acb/vo_card_cmn_00030_00030-5-uniq-0024-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "How’s my little hand on your cheek feel? Is it warm?",
            "audio": "resources/vo_card_cmn_00030_00030-5-uniq-0024-00_potential-004.acb/vo_card_cmn_00030_00030-5-uniq-0024-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Let’s definitely watch the illuminations together again next year!",
            "audio": "resources/vo_card_cmn_00030_00030-5-uniq-0024-00_potential-005.acb/vo_card_cmn_00030_00030-5-uniq-0024-00_potential-005.mp3"
        }
    ],
