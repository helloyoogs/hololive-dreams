    "voicelines": [
        {
            "type": "card_get",
            "text": "I'm so glad I get to spend this summer with everyone... Let's enjoy it to the fullest!",
            "audio": "resources/vo_live_dial_card_00036_00036-5-uniq-0078-00_myself.acb/vo_live_dial_card_00036_00036-5-uniq-0078-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "The salt-scented sea breeze... The sound of waves caressing my ears... And the twins bathing in the sea ever so delightfully... \nIs this what they call paradise? Shouldn't life be charging for a view like this?\nWait, whaaaat?! The twins are waving at me?!\nWha-What should I do?!\n...Okay, okay. I'll just naturally, calmly, wave back at them, as if nothing happened...\nAaaah?! They waved back even harder?!\nGoodness gracious! For a wall like me to be blessed like this...!",
            "audio": "resources/vo_card_cmn_00036_00036-5-uniq-0078-00_situation.acb/vo_card_cmn_00036_00036-5-uniq-0078-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Hawk Eyes: Summer Mode activated!",
            "audio": "resources/vo_live_cmn_card_00036_00036-5-uniq-0078-00_skill-card.acb/vo_live_cmn_card_00036_00036-5-uniq-0078-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "My heart can't take any more happiness right now...! I'll step out for a sec...",
            "audio": "resources/vo_card_cmn_00036_00036-5-uniq-0078-00_potential-001.acb/vo_card_cmn_00036_00036-5-uniq-0078-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Ahh, the breeze feels so nice! Mhmm, 'tis the smell of summer!",
            "audio": "resources/vo_card_cmn_00036_00036-5-uniq-0078-00_potential-002.acb/vo_card_cmn_00036_00036-5-uniq-0078-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "My glowing skin is beautiful? Hehe, buttering me up won't get you anything!",
            "audio": "resources/vo_card_cmn_00036_00036-5-uniq-0078-00_potential-003.acb/vo_card_cmn_00036_00036-5-uniq-0078-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "I get wanting to play in the sea, but better not today. You didn't bring a towel, did you?",
            "audio": "resources/vo_card_cmn_00036_00036-5-uniq-0078-00_potential-004.acb/vo_card_cmn_00036_00036-5-uniq-0078-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Maybe we should bring a lunch box for our next walk. I'll make potato salad and sandwiches!",
            "audio": "resources/vo_card_cmn_00036_00036-5-uniq-0078-00_potential-005.acb/vo_card_cmn_00036_00036-5-uniq-0078-00_potential-005.mp3"
        }
    ],
