    "voicelines": [
        {
            "type": "card_get",
            "text": "I hope my love and support will reach all the Takodachis... \nI love you!",
            "audio": "resources/vo_live_dial_card_04003_04003-5-uniq-0044-00_myself.acb/vo_live_dial_card_04003_04003-5-uniq-0044-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Hehe, it turned out nicely. Alright, time to eat.\nOm...nom... Mmm~ so warm and fresh. Freshly roasted sweet potatoes really are the best!\n...Um, wh-what? Why are you staring at me like that?\nIt's so hard to eat when you're watching me... If you keep that up, no roasted sweet potatoes for you.\nHehe... I was just pulling your leg. Here, take some. It's hot so be careful, okay?\nWe've got tons left, so you should try eating them with the peel! They’re surprisingly good that way. Hehe",
            "audio": "resources/vo_card_cmn_04003_04003-5-uniq-0044-00_situation.acb/vo_card_cmn_04003_04003-5-uniq-0044-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "I'm not tako bocchi!",
            "audio": "resources/vo_live_cmn_card_04003_04003-5-uniq-0044-00_skill-card.acb/vo_live_cmn_card_04003_04003-5-uniq-0044-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "I gave my kimono a little twist~ Hey! Stop staring at me like that...",
            "audio": "resources/vo_card_cmn_04003_04003-5-uniq-0044-00_potential-001.acb/vo_card_cmn_04003_04003-5-uniq-0044-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "I wanna eat roasted sweet potato again. I can't forget that sweet taste melting in my mouth.",
            "audio": "resources/vo_card_cmn_04003_04003-5-uniq-0044-00_potential-002.acb/vo_card_cmn_04003_04003-5-uniq-0044-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Wait, you collected fallen leaves for me?! Thanks! Let's roast some sweet potatoes now~",
            "audio": "resources/vo_card_cmn_04003_04003-5-uniq-0044-00_potential-003.acb/vo_card_cmn_04003_04003-5-uniq-0044-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Oh, a cat~ Come here~ Let me see your toe beans, so soft and squishy.",
            "audio": "resources/vo_card_cmn_04003_04003-5-uniq-0044-00_potential-004.acb/vo_card_cmn_04003_04003-5-uniq-0044-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Um... If you don't mind, maybe we can just hang out and chat sometime? Like, while we soak up the sun on the porch?",
            "audio": "resources/vo_card_cmn_04003_04003-5-uniq-0044-00_potential-005.acb/vo_card_cmn_04003_04003-5-uniq-0044-00_potential-005.mp3"
        }
    ],
