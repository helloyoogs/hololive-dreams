    "voicelines": [
        {
            "type": "card_get",
            "text": "All right, lean in close... I LOVE YOU ALL!!",
            "audio": "resources/vo_live_dial_card_00016_00016-5-uniq-0014-00_myself.acb/vo_live_dial_card_00016_00016-5-uniq-0014-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Been working hard today? Ahaha, do you need a shoulder rub?\nI mean, you are always helping out so much with the store.\nAs thanks, let me make the stresses of the day fade away...\nWhat would you like? A massage? Shoulders? Or a full-body massage?\nI'll rub anything you want. Ahaha, your face has gone bright red!\nWere you thinking naughty thoughts? Hehe... Come on. This place won't clean itself up.\nOh, but I wanna hear what sort of massage you want before we're done, okay?",
            "audio": "resources/vo_card_cmn_00016_00016-5-uniq-0014-00_situation.acb/vo_card_cmn_00016_00016-5-uniq-0014-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Why not me?",
            "audio": "resources/vo_live_cmn_card_00016_00016-5-uniq-0014-00_skill-card.acb/vo_live_cmn_card_00016_00016-5-uniq-0014-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Ta-da! It's Nekomata Okayu in maid form, here to prank your butt!",
            "audio": "resources/vo_card_cmn_00016_00016-5-uniq-0014-00_potential-001.acb/vo_card_cmn_00016_00016-5-uniq-0014-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "I've got just the thing for your omelet rice today... Moe moe kyun!",
            "audio": "resources/vo_card_cmn_00016_00016-5-uniq-0014-00_potential-002.acb/vo_card_cmn_00016_00016-5-uniq-0014-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Oh please? Won't you be my master?",
            "audio": "resources/vo_card_cmn_00016_00016-5-uniq-0014-00_potential-003.acb/vo_card_cmn_00016_00016-5-uniq-0014-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "You can do it! You can do it! Go, go, master!",
            "audio": "resources/vo_card_cmn_00016_00016-5-uniq-0014-00_potential-004.acb/vo_card_cmn_00016_00016-5-uniq-0014-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "I LOVE being together with my master! Please don't ever let me go!",
            "audio": "resources/vo_card_cmn_00016_00016-5-uniq-0014-00_potential-005.acb/vo_card_cmn_00016_00016-5-uniq-0014-00_potential-005.mp3"
        }
    ],
