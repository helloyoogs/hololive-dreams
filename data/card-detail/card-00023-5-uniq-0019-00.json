    "voicelines": [
        {
            "type": "card_get",
            "text": "Swear it on your life, your soul, your lips... \nForever, and only me!",
            "audio": "resources/vo_live_dial_card_00023_00023-5-uniq-0019-00_myself.acb/vo_live_dial_card_00023_00023-5-uniq-0019-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "The sky is as clear as it gets, and the breeze is perfect. Truly a perfect day for sailing~♪\nToday our goal is a no-man island southwest, heading toward treasure we've never seen, yohoho!\nHey hey ♪ Are you paying attention at your captain’s captains~?\nMy plump tights, maybe? Or my world-famous body?\nYou should be focused doing deck work instead of thinking with it, you bad boys.\nWith that said, make sure to come to the captain's room later!\nSome one sure is in need of correction! ♪",
            "audio": "resources/vo_card_cmn_00023_00023-5-uniq-0019-00_situation.acb/vo_card_cmn_00023_00023-5-uniq-0019-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Take this! Sexy beam!",
            "audio": "resources/vo_live_cmn_card_00023_00023-5-uniq-0019-00_skill-card.acb/vo_live_cmn_card_00023_00023-5-uniq-0019-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Iyaan ♡ Even though the captain’s sexy, aren’t you staring a little too much ☆",
            "audio": "resources/vo_card_cmn_00023_00023-5-uniq-0019-00_potential-001.acb/vo_card_cmn_00023_00023-5-uniq-0019-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Hnnnn ♪ My pants are super tight~ ♪",
            "audio": "resources/vo_card_cmn_00023_00023-5-uniq-0019-00_potential-002.acb/vo_card_cmn_00023_00023-5-uniq-0019-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Oh no! My chest feels soo tight! My clothes are about to burst off!",
            "audio": "resources/vo_card_cmn_00023_00023-5-uniq-0019-00_potential-003.acb/vo_card_cmn_00023_00023-5-uniq-0019-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "To think you’d do this to me ♡ With you, I can go anywhere ♡",
            "audio": "resources/vo_card_cmn_00023_00023-5-uniq-0019-00_potential-004.acb/vo_card_cmn_00023_00023-5-uniq-0019-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "I'm sorry, my crewmates. My clothes didn’t burst off, but my heart has. Please, do as you like with the captain ♡",
            "audio": "resources/vo_card_cmn_00023_00023-5-uniq-0019-00_potential-005.acb/vo_card_cmn_00023_00023-5-uniq-0019-00_potential-005.mp3"
        }
