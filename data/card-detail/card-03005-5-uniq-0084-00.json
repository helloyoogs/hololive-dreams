    "voicelines": [
        {
            "type": "card_get",
            "text": "Summer and this live aren't over yet, okay? Let’s enjoy every last bit of it together!",
            "audio": "resources/vo_live_dial_card_03005_03005-5-uniq-0084-00_myself.acb/vo_live_dial_card_03005_03005-5-uniq-0084-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Ugh...! It's really the peak of summer, huh?\nI seriously can't go anywhere without my portable fan...\nHm? What's up? Oh! Is that watermelon juice?!\nIs that for me? Wow, you're a lifesaver!\n...Huh? Jump in the water after this? Hmm... I'm feeling lazy, but I did skip it last time, so... Alright, let's do it!\nActually, drifting off while the waves rock me sounds pretty nice too.\nAhahaha, okay, now I'm actually getting hyped!",
            "audio": "resources/vo_card_cmn_03005_03005-5-uniq-0084-00_situation.acb/vo_card_cmn_03005_03005-5-uniq-0084-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Nothing beats an air conditioner during summer!",
            "audio": "resources/vo_live_cmn_card_03005_03005-5-uniq-0084-00_skill-card.acb/vo_live_cmn_card_03005_03005-5-uniq-0084-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Hm? My swimsuit? You think it suits me? Ahaha, thanks~",
            "audio": "resources/vo_card_cmn_03005_03005-5-uniq-0084-00_potential-001.acb/vo_card_cmn_03005_03005-5-uniq-0084-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Alright, time to go floating. I’m gonna grab a serious nap on my floatie while the waves rock me back and forth!",
            "audio": "resources/vo_card_cmn_03005_03005-5-uniq-0084-00_potential-002.acb/vo_card_cmn_03005_03005-5-uniq-0084-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Wait, scratch that. I'll take this one instead. It looks way better for napping.",
            "audio": "resources/vo_card_cmn_03005_03005-5-uniq-0084-00_potential-003.acb/vo_card_cmn_03005_03005-5-uniq-0084-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "The sun is so warm and the ocean feels great... It's the perfect balance... I could totally pass out right now...",
            "audio": "resources/vo_card_cmn_03005_03005-5-uniq-0084-00_potential-004.acb/vo_card_cmn_03005_03005-5-uniq-0084-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "*yawn* Okay, let's get moving. Once we're back on the beach, let's take a nap.",
            "audio": "resources/vo_card_cmn_03005_03005-5-uniq-0084-00_potential-005.acb/vo_card_cmn_03005_03005-5-uniq-0084-00_potential-005.mp3"
        }
    ],
