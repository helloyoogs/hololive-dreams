    "voicelines": [
        {
            "type": "card_get",
            "text": "We don't need no crystal balls to see the fun \nwe're about to have!",
            "audio": "resources/vo_live_dial_card_00014_00014-5-uniq-0013-00_myself.acb/vo_live_dial_card_00014_00014-5-uniq-0013-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "What do you think about this place? It has a nice atmosphere, it’s quiet, stylish, and the view is great.\nIt’s the perfect place to talk at a relaxed pace, right? Hey, what’s wrong? You look kinda tense.\nAre you nervous? Oh, come to think of it, didn’t you say this kind of place is a first for you?\nOkay, no worries! I’ll take the lead today!\nYou just need to relax!\nI guess that’s not so easy right away, huh? Well, for now, let’s just make a toast ♪",
            "audio": "resources/vo_card_cmn_00014_00014-5-uniq-0013-00_situation.acb/vo_card_cmn_00014_00014-5-uniq-0013-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "You can't stop the wolf!",
            "audio": "resources/vo_live_cmn_card_00014_00014-5-uniq-0013-00_skill-card.acb/vo_live_cmn_card_00014_00014-5-uniq-0013-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Isn’t this outfit a little too mature for me? I‘m not really sure it suits me...",
            "audio": "resources/vo_card_cmn_00014_00014-5-uniq-0013-00_potential-001.acb/vo_card_cmn_00014_00014-5-uniq-0013-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Dining out at night just feels so special... But homemade meals at home are nice too ♪",
            "audio": "resources/vo_card_cmn_00014_00014-5-uniq-0013-00_potential-002.acb/vo_card_cmn_00014_00014-5-uniq-0013-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "If you want, I can listen to your concerns, since we’re next to each other anyways ♪",
            "audio": "resources/vo_card_cmn_00014_00014-5-uniq-0013-00_potential-003.acb/vo_card_cmn_00014_00014-5-uniq-0013-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "I see. You’ve been through a lot and you did your best. *headpats*",
            "audio": "resources/vo_card_cmn_00014_00014-5-uniq-0013-00_potential-004.acb/vo_card_cmn_00014_00014-5-uniq-0013-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Thanks a lot for today. I’m lucky to have spent such a fun time ♪",
            "audio": "resources/vo_card_cmn_00014_00014-5-uniq-0013-00_potential-005.acb/vo_card_cmn_00014_00014-5-uniq-0013-00_potential-005.mp3"
        }
    ],
