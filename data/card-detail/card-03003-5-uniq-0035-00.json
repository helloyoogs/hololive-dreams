    "voicelines": [
        {
            "type": "card_get",
            "text": "Your supports mean the world to me! And as\na special treat... Quality time with yours truly!♡",
            "audio": "resources/vo_live_dial_card_03003_03003-5-uniq-0035-00_myself.acb/vo_live_dial_card_03003_03003-5-uniq-0035-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "So... I'm gonna paint this part red... Oh, welcome!\nSorry, I'm still working on this drawing right now.\nJust a little bit more and I'll be done, then we can start the drawing lesson.\nSo just hang out and relax till I finish.\nLet’s see, next I’ll put this here... Hmm? Hey, hey! Stop staring so much, you're making me blush!\nYou were looking at me just now, weren't you? Ah, wait... don't tell me.. You've fallen for the way I look when I'm drawing~?\nDon't hide it, just say it! You silly, hehe...",
            "audio": "resources/vo_card_cmn_03003_03003-5-uniq-0035-00_situation.acb/vo_card_cmn_03003_03003-5-uniq-0035-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Hey, aren't you staring at me a little bit too much?♪",
            "audio": "resources/vo_live_cmn_card_03003_03003-5-uniq-0035-00_skill-card.acb/vo_live_cmn_card_03003_03003-5-uniq-0035-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Hehe, this outer's super cute, right♪ And check out this zettairyouiki too~",
            "audio": "resources/vo_card_cmn_03003_03003-5-uniq-0035-00_potential-001.acb/vo_card_cmn_03003_03003-5-uniq-0035-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Okay, let's get started with my drawing class! Stand up, bow~",
            "audio": "resources/vo_card_cmn_03003_03003-5-uniq-0035-00_potential-002.acb/vo_card_cmn_03003_03003-5-uniq-0035-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Oh nice! Those are nice color combinations! I love it!",
            "audio": "resources/vo_card_cmn_03003_03003-5-uniq-0035-00_potential-003.acb/vo_card_cmn_03003_03003-5-uniq-0035-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Is your drawing finished? Oh, hey, not bad! My score for you is... a 100 with a gold star!",
            "audio": "resources/vo_card_cmn_03003_03003-5-uniq-0035-00_potential-004.acb/vo_card_cmn_03003_03003-5-uniq-0035-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Wanna draw together with me next time? The theme should be... 'Love,' maybe?",
            "audio": "resources/vo_card_cmn_03003_03003-5-uniq-0035-00_potential-005.acb/vo_card_cmn_03003_03003-5-uniq-0035-00_potential-005.mp3"
        }
