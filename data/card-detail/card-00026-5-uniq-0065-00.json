    "voicelines": [
        {
            "type": "card_get",
            "text": "Everyone! Let’s make this a great summer memory together! \nHave a nice day~♪",
            "audio": "resources/vo_live_dial_card_00026_00026-5-uniq-0065-00_myself.acb/vo_live_dial_card_00026_00026-5-uniq-0065-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Aaaah... Floating in the sea like this sure is nice!\nI enjoyed floating around when we last came. I could get used to this.\nAnother thing I can get used to is...this!\nHahaha, that was my chance. You should've been paying attention.\nDon't blame me... Hmpf...!\nUgh,,, I'm soaking wet! So that is how it is, huh? Take this! Ahahaha!",
            "audio": "resources/vo_card_cmn_00026_00026-5-uniq-0065-00_situation.acb/vo_card_cmn_00026_00026-5-uniq-0065-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "The summer side boobs are the best!",
            "audio": "resources/vo_live_cmn_card_00026_00026-5-uniq-0065-00_skill-card.acb/vo_live_cmn_card_00026_00026-5-uniq-0065-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Ehehe, do you think this swimsuit suits me? Oh, you’ve turned red all of a sudden!",
            "audio": "resources/vo_card_cmn_00026_00026-5-uniq-0065-00_potential-001.acb/vo_card_cmn_00026_00026-5-uniq-0065-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "I am hungry~! Someone feed me! *glances*",
            "audio": "resources/vo_card_cmn_00026_00026-5-uniq-0065-00_potential-002.acb/vo_card_cmn_00026_00026-5-uniq-0065-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Yummy! Curry by the sea is really something else. Thank you for buyin’ it!",
            "audio": "resources/vo_card_cmn_00026_00026-5-uniq-0065-00_potential-003.acb/vo_card_cmn_00026_00026-5-uniq-0065-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "What should we do next? Have a swim? I will show you my well-honed swimming skills!♪",
            "audio": "resources/vo_card_cmn_00026_00026-5-uniq-0065-00_potential-004.acb/vo_card_cmn_00026_00026-5-uniq-0065-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Woah, a sunset at the beach! It is so beautiful! Let’s come together to watch this scene again!",
            "audio": "resources/vo_card_cmn_00026_00026-5-uniq-0065-00_potential-005.acb/vo_card_cmn_00026_00026-5-uniq-0065-00_potential-005.mp3"
        }
    ],
