    "voicelines": [
        {
            "type": "card_get",
            "text": "Do you love me just as I am?",
            "audio": "resources/vo_live_dial_card_06003_06003-5-uniq-0059-00_myself.acb/vo_live_dial_card_06003_06003-5-uniq-0059-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Heya! Nice work today. And you know what hard workers deserve? A present! From Ririka!\nTa-da! It's a Struggling Meal! I made it just for you.\nWell? Don't those sausages look good? Mmm... They're glistening!\nI thought you'd be hungry around lunch time, so I went ahead and scrounged something up for you.\nWell, go on then! Huh? You don't want it? Oh, I know what YOU want...\nYou want me to feed it to you! Fine, fine. If you insist. Say Aah! Hehe, but really... You did good today.",
            "audio": "resources/vo_card_cmn_06003_06003-5-uniq-0059-00_situation.acb/vo_card_cmn_06003_06003-5-uniq-0059-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "I'll show you what this entrepreneur's got!",
            "audio": "resources/vo_live_cmn_card_06003_06003-5-uniq-0059-00_skill-card.acb/vo_live_cmn_card_06003_06003-5-uniq-0059-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Et voilà! I'm your friendly JK gal high school CEO! Are you excited? 'Cause you should be! Ehehe!",
            "audio": "resources/vo_card_cmn_06003_06003-5-uniq-0059-00_potential-001.acb/vo_card_cmn_06003_06003-5-uniq-0059-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Let me know if you need anything, okay? I know ALL sorts of remedies...",
            "audio": "resources/vo_card_cmn_06003_06003-5-uniq-0059-00_potential-002.acb/vo_card_cmn_06003_06003-5-uniq-0059-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Oh, shoot! Where did my files go? Will you help me find them? Pleeease?",
            "audio": "resources/vo_card_cmn_06003_06003-5-uniq-0059-00_potential-003.acb/vo_card_cmn_06003_06003-5-uniq-0059-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "You drafted all this up for me?! Wow, you're the best!",
            "audio": "resources/vo_card_cmn_06003_06003-5-uniq-0059-00_potential-004.acb/vo_card_cmn_06003_06003-5-uniq-0059-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Thanks for always being there for me. I hope I can continue counting on you!",
            "audio": "resources/vo_card_cmn_06003_06003-5-uniq-0059-00_potential-005.acb/vo_card_cmn_06003_06003-5-uniq-0059-00_potential-005.mp3"
        }
    ],
