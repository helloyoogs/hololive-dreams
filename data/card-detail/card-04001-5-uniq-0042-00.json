    "voicelines": [
        {
            "type": "card_get",
            "text": "Having you guys here makes it not scary. \nThank you for making things better.",
            "audio": "resources/vo_live_dial_card_04001_04001-5-uniq-0042-00_myself.acb/vo_live_dial_card_04001_04001-5-uniq-0042-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Are you all fired up?! ...Haha, now that's what I call Call and Response. My energy's through the roof!\nAlright, Mori Calliope's tour is in its final phase. Let's push through and have a blast till the finish!\n...Though, don't get so caught up that you skip hydration, got it?\nDon't let your guard down for a second! If you feel sick, you won't be able to enjoy it till the end, right?\n...Alright, everyone set? Here comes the next banger! Make some noise!",
            "audio": "resources/vo_card_cmn_04001_04001-5-uniq-0042-00_situation.acb/vo_card_cmn_04001_04001-5-uniq-0042-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Now it's the Reaper's turn!",
            "audio": "resources/vo_live_cmn_card_04001_04001-5-uniq-0042-00_skill-card.acb/vo_live_cmn_card_04001_04001-5-uniq-0042-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Cool thread, right? Anyone whose eyes are captivated is getting their soul reaped... Haha, just kidding!",
            "audio": "resources/vo_card_cmn_04001_04001-5-uniq-0042-00_potential-001.acb/vo_card_cmn_04001_04001-5-uniq-0042-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Nothing beats a live performance! But... If I curse, cut me some slack~",
            "audio": "resources/vo_card_cmn_04001_04001-5-uniq-0042-00_potential-002.acb/vo_card_cmn_04001_04001-5-uniq-0042-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "How's everyone doing?! ...Wait, was the mic even on?!",
            "audio": "resources/vo_card_cmn_04001_04001-5-uniq-0042-00_potential-003.acb/vo_card_cmn_04001_04001-5-uniq-0042-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "There's no set way to vibe at a live show! Have fun your own way!",
            "audio": "resources/vo_card_cmn_04001_04001-5-uniq-0042-00_potential-004.acb/vo_card_cmn_04001_04001-5-uniq-0042-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Thanks for showing up to the live today. I promise to bring you the sickest tracks from here on out!",
            "audio": "resources/vo_card_cmn_04001_04001-5-uniq-0042-00_potential-005.acb/vo_card_cmn_04001_04001-5-uniq-0042-00_potential-005.mp3"
        }
    ],
