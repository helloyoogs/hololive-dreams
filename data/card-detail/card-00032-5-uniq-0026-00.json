    "voicelines": [
        {
            "type": "card_get",
            "text": "Couldn't have done it without you! \nOkay, who's ready to party?",
            "audio": "resources/vo_live_dial_card_00032_00032-5-uniq-0026-00_myself.acb/vo_live_dial_card_00032_00032-5-uniq-0026-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Where could the enemy be hiding...?\nOh my... Don’t you know it’s dangerous to peek out from behind the barricade like that?\nHide properly and stay out the line of sight. Huh? Your face is really pale... Are you nervous, by any chance?\nI see, I see! Don’t worry~ Even if things get tough, I’ll definitely protect you!\nAh, there they are! What are they doing hiding in a spot like that~\nC’mon, let’s go take them out!",
            "audio": "resources/vo_card_cmn_00032_00032-5-uniq-0026-00_situation.acb/vo_card_cmn_00032_00032-5-uniq-0026-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Take this! Paon!",
            "audio": "resources/vo_live_cmn_card_00032_00032-5-uniq-0026-00_skill-card.acb/vo_live_cmn_card_00032_00032-5-uniq-0026-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Isn’t this outfit cool~? It really gives you some “Commencing attack!” military vibes ♪",
            "audio": "resources/vo_card_cmn_00032_00032-5-uniq-0026-00_potential-001.acb/vo_card_cmn_00032_00032-5-uniq-0026-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Enemy spotted! Lock on! That’s one down!",
            "audio": "resources/vo_card_cmn_00032_00032-5-uniq-0026-00_potential-002.acb/vo_card_cmn_00032_00032-5-uniq-0026-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "What a close one... Thank you for helping out! I’ll definitely repay you for this!",
            "audio": "resources/vo_card_cmn_00032_00032-5-uniq-0026-00_potential-003.acb/vo_card_cmn_00032_00032-5-uniq-0026-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Phew~ I’m so pooped. What do you say about having some ramen on the way back?",
            "audio": "resources/vo_card_cmn_00032_00032-5-uniq-0026-00_potential-004.acb/vo_card_cmn_00032_00032-5-uniq-0026-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Next time I’ll also leave my back to you, partner ♪",
            "audio": "resources/vo_card_cmn_00032_00032-5-uniq-0026-00_potential-005.acb/vo_card_cmn_00032_00032-5-uniq-0026-00_potential-005.mp3"
        }
    ],
