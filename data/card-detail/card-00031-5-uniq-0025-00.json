    "voicelines": [
        {
            "type": "card_get",
            "text": "Look at my beautiful husband collection! I love you all!",
            "audio": "resources/vo_live_dial_card_00031_00031-5-uniq-0025-00_myself.acb/vo_live_dial_card_00031_00031-5-uniq-0025-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Are you all enjoying my show?\nI'm gonna check in on you to see how big your smiles are!\nHmm... Hmm... Aah, yes... Look at all those lovely smiles! But they're not as big as mine!\nSo if your smiles a little on the smaller side, let me give you some of mine!\nBecause you know what I am, right?\nI'm your... ENERGY DRINK! And so I have a challenge for you!\nWhoever's got the bigger smile after the next song wins! Are you ready for it?",
            "audio": "resources/vo_card_cmn_00031_00031-5-uniq-0025-00_situation.acb/vo_card_cmn_00031_00031-5-uniq-0025-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "This is Super Nenechi!",
            "audio": "resources/vo_live_cmn_card_00031_00031-5-uniq-0025-00_skill-card.acb/vo_live_cmn_card_00031_00031-5-uniq-0025-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Look at all the flowers on my outfit! It's gonna draw all the bugs!",
            "audio": "resources/vo_card_cmn_00031_00031-5-uniq-0025-00_potential-001.acb/vo_card_cmn_00031_00031-5-uniq-0025-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "And look! My face is a flower in bloom too! Wahaha!",
            "audio": "resources/vo_card_cmn_00031_00031-5-uniq-0025-00_potential-002.acb/vo_card_cmn_00031_00031-5-uniq-0025-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Look! Look at my nice legs! How do they look?",
            "audio": "resources/vo_card_cmn_00031_00031-5-uniq-0025-00_potential-003.acb/vo_card_cmn_00031_00031-5-uniq-0025-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Come on, let's go catch bugs together! Right now!",
            "audio": "resources/vo_card_cmn_00031_00031-5-uniq-0025-00_potential-004.acb/vo_card_cmn_00031_00031-5-uniq-0025-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "We'll be together forever, right? You gotta PROMISE me, okay?",
            "audio": "resources/vo_card_cmn_00031_00031-5-uniq-0025-00_potential-005.acb/vo_card_cmn_00031_00031-5-uniq-0025-00_potential-005.mp3"
        }
    ],
