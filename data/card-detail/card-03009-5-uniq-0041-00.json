    "voicelines": [
        {
            "type": "card_get",
            "text": "Feeling down? No worries! \nKobo will turn everyone's hearts into blue skies!",
            "audio": "resources/vo_live_dial_card_03009_03009-5-uniq-0041-00_myself.acb/vo_live_dial_card_03009_03009-5-uniq-0041-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Ta-da! Look at that blue sky!\nI was just about to use my Rain Shaman powers, but the rain already stopped!\n...Wait? Oooooh! There's a rainbow over there! Whoooaaa it looks amazing!\nI wanna see that rainbow up close! And then, like, climb on it and slide down!\nCome on! Let's go after it!\nHurry up ♪ We gotta move fast, If we don't hurry, it’s gonna disappeaaar!",
            "audio": "resources/vo_card_cmn_03009_03009-5-uniq-0041-00_situation.acb/vo_card_cmn_03009_03009-5-uniq-0041-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Call me Princess Kobo!!!",
            "audio": "resources/vo_live_cmn_card_03009_03009-5-uniq-0041-00_skill-card.acb/vo_live_cmn_card_03009_03009-5-uniq-0041-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Hey, what do you think of my outfit? Hehe, cool, right?",
            "audio": "resources/vo_card_cmn_03009_03009-5-uniq-0041-00_potential-001.acb/vo_card_cmn_03009_03009-5-uniq-0041-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Oh! I found a puddle! Okay, here we go—JUUUMP!",
            "audio": "resources/vo_card_cmn_03009_03009-5-uniq-0041-00_potential-002.acb/vo_card_cmn_03009_03009-5-uniq-0041-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "I'm starviiiing... Wait, you're buying me ramen?! Yaaaaay ♪",
            "audio": "resources/vo_card_cmn_03009_03009-5-uniq-0041-00_potential-003.acb/vo_card_cmn_03009_03009-5-uniq-0041-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Huh, it's raining?! Umbrella... Where's my umbrella... Oh no, I left it at the ramen place!",
            "audio": "resources/vo_card_cmn_03009_03009-5-uniq-0041-00_potential-004.acb/vo_card_cmn_03009_03009-5-uniq-0041-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Thanks for sharing your umbrella with me! Hehe, gotta watch out or we'll bump shoulders~",
            "audio": "resources/vo_card_cmn_03009_03009-5-uniq-0041-00_potential-005.acb/vo_card_cmn_03009_03009-5-uniq-0041-00_potential-005.mp3"
        }
    ],
