    "voicelines": [
        {
            "type": "card_get",
            "text": "Follow me! Those pesky humans are exhausted by the heat so...it's the perfect chance to enact WORLD DOMINATION!",
            "audio": "resources/vo_live_dial_card_00035_00035-5-uniq-0082-00_myself.acb/vo_live_dial_card_00035_00035-5-uniq-0082-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Uhyooo, this feels sooo good~♪\nI thought summer was all about lazing around in my room, but just soaking in the water is pretty much top tier, too~♪\nIt would be perfect if you could smile gently like before...while you also coldly insult me~♪\nHm? Whazzat? You've brought some ice-cold watermelon for me?!\nA job well done! Hurry up, bring it here!\nOh, by the way, could you also pass me some cold juice? A-And make sure it's the fizzy kind!",
            "audio": "resources/vo_card_cmn_00035_00035-5-uniq-0082-00_situation.acb/vo_card_cmn_00035_00035-5-uniq-0082-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Beat the heat...and feast your eyes upon me!",
            "audio": "resources/vo_live_cmn_card_00035_00035-5-uniq-0082-00_skill-card.acb/vo_live_cmn_card_00035_00035-5-uniq-0082-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "I-It's not like I put on a swimsuit j-just for you or anything! Well...? Is it tsuntsun enough for your heart to melt?",
            "audio": "resources/vo_card_cmn_00035_00035-5-uniq-0082-00_potential-001.acb/vo_card_cmn_00035_00035-5-uniq-0082-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Aaah, this is heaven~♪ Hey, hey, fan me with that fan!",
            "audio": "resources/vo_card_cmn_00035_00035-5-uniq-0082-00_potential-002.acb/vo_card_cmn_00035_00035-5-uniq-0082-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Ugh, my hair's totally soaked! Well, it'll dry if I leave it under this scorching heat...",
            "audio": "resources/vo_card_cmn_00035_00035-5-uniq-0082-00_potential-003.acb/vo_card_cmn_00035_00035-5-uniq-0082-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "You're a lifesaver! Now I don't even have to use a hairdryer myself!",
            "audio": "resources/vo_card_cmn_00035_00035-5-uniq-0082-00_potential-004.acb/vo_card_cmn_00035_00035-5-uniq-0082-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "So sleepy~ How can I get this tired from just playing? Hey, you! Take me to my room!",
            "audio": "resources/vo_card_cmn_00035_00035-5-uniq-0082-00_potential-005.acb/vo_card_cmn_00035_00035-5-uniq-0082-00_potential-005.mp3"
        }
    ],
