    "voicelines": [
        {
            "type": "card_get",
            "text": "You guys! I'll keep running...\nWe'll keep running...",
            "audio": "resources/vo_live_dial_card_00001_00001-5-uniq-0000-00_myself.acb/vo_live_dial_card_00001_00001-5-uniq-0000-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Thank you for coming to see me on stage today ♪ How is it? Are you enjoying it?\nI’m having so much fun! I get to sing all my favorite songs under such a beautiful blue sky!\nLook, look! A rainbow ♪\nCould it be that my singing made a rainbow appear~? Then I will make an even bigger one!\nI’d be so happy if you could follow me all the way to the end, just like racing through that blue sky!\nLet’s go! Nun nun ♪",
            "audio": "resources/vo_card_cmn_00001_00001-5-uniq-0000-00_situation.acb/vo_card_cmn_00001_00001-5-uniq-0000-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "You can't stop me now!",
            "audio": "resources/vo_live_cmn_card_00001_00001-5-uniq-0000-00_skill-card.acb/vo_live_cmn_card_00001_00001-5-uniq-0000-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Do you like this design? It looks like I trapped the sky in my outfit ♪",
            "audio": "resources/vo_card_cmn_00001_00001-5-uniq-0000-00_potential-001.acb/vo_card_cmn_00001_00001-5-uniq-0000-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Hmm, what kind of set list should I go for~? I’d better start planning it right now!",
            "audio": "resources/vo_card_cmn_00001_00001-5-uniq-0000-00_potential-002.acb/vo_card_cmn_00001_00001-5-uniq-0000-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Being able to do what I do isn’t something to take for granted... I really need to be thankful to everyone who supports me ♪",
            "audio": "resources/vo_card_cmn_00001_00001-5-uniq-0000-00_potential-003.acb/vo_card_cmn_00001_00001-5-uniq-0000-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Pffft! I thought it was a microphone, but it was a water bottle... Do not laugh at me please ♪",
            "audio": "resources/vo_card_cmn_00001_00001-5-uniq-0000-00_potential-004.acb/vo_card_cmn_00001_00001-5-uniq-0000-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Will you come to the next concert too? It’s a promise, okay?! Let’s pinky swear so you don’t forget ♪",
            "audio": "resources/vo_card_cmn_00001_00001-5-uniq-0000-00_potential-005.acb/vo_card_cmn_00001_00001-5-uniq-0000-00_potential-005.mp3"
        }
    ],
