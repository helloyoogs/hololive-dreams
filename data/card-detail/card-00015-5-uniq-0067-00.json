    "voicelines": [
        {
            "type": "card_get",
            "text": "Let’s get wet head to toe \nand enjoy this summer show together!",
            "audio": "resources/vo_live_dial_card_00015_00015-5-uniq-0067-00_myself.acb/vo_live_dial_card_00015_00015-5-uniq-0067-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Miko-chan peeeeeew!!! Yes, yes, yes! I hit it! Yes!\nHehehe! I will keep going and decimate Sui-chan’s team!\nOh, what? I am all of a sudden surrounded by the enemy team...\nDon’t you point those water guns at me! Are you not ashamed of ganging up on me like this?\n...Ah. I was just joking... I would very much appreciate it if you'd lower your water guns...\nAh...ah.. Aaaaaaaaaargh!!!",
            "audio": "resources/vo_card_cmn_00015_00015-5-uniq-0067-00_situation.acb/vo_card_cmn_00015_00015-5-uniq-0067-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Sunshine Miko-chan Smile!",
            "audio": "resources/vo_live_cmn_card_00015_00015-5-uniq-0067-00_skill-card.acb/vo_live_cmn_card_00015_00015-5-uniq-0067-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Hey, I look good in this swimsuit, no? Hehehe!",
            "audio": "resources/vo_card_cmn_00015_00015-5-uniq-0067-00_potential-001.acb/vo_card_cmn_00015_00015-5-uniq-0067-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Like, sunglasses are part of any grown-up’s essentials, obviously.",
            "audio": "resources/vo_card_cmn_00015_00015-5-uniq-0067-00_potential-002.acb/vo_card_cmn_00015_00015-5-uniq-0067-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Nice, nice, nice! Good moves!♪ Destroy all enemies!",
            "audio": "resources/vo_card_cmn_00015_00015-5-uniq-0067-00_potential-003.acb/vo_card_cmn_00015_00015-5-uniq-0067-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Oh no! They’re gonna get me! Someone please be my shield!",
            "audio": "resources/vo_card_cmn_00015_00015-5-uniq-0067-00_potential-004.acb/vo_card_cmn_00015_00015-5-uniq-0067-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Oooh, oh... Thank you for covering up for me back there! I will protect you now, promise!",
            "audio": "resources/vo_card_cmn_00015_00015-5-uniq-0067-00_potential-005.acb/vo_card_cmn_00015_00015-5-uniq-0067-00_potential-005.mp3"
        }
    ],
