    "voicelines": [
        {
            "type": "card_get",
            "text": "Thanks so much for spending the day with me! I love you!",
            "audio": "resources/vo_live_dial_card_00017_00017-5-uniq-0015-00_myself.acb/vo_live_dial_card_00017_00017-5-uniq-0015-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Sorry for the wait! Here is your order!\nWhat? You didn’t order this much? Everything except the parfait is on the house!\nIt’s a little more than I intended...but, well, you can still eat it, RIGHT?\nOh, by the way. My recommendation is...everything! Ahaha! Because they're all unbelievably delicious!\nJust one bite and your cheeks will feel like you’re doing a bungee jump! Come on, eat up~",
            "audio": "resources/vo_card_cmn_00017_00017-5-uniq-0015-00_situation.acb/vo_card_cmn_00017_00017-5-uniq-0015-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Here! It's me! Here I am!",
            "audio": "resources/vo_live_cmn_card_00017_00017-5-uniq-0015-00_skill-card.acb/vo_live_cmn_card_00017_00017-5-uniq-0015-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "How about this frilly outfit~? Cute, right?",
            "audio": "resources/vo_card_cmn_00017_00017-5-uniq-0015-00_potential-001.acb/vo_card_cmn_00017_00017-5-uniq-0015-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Behold my splendid saleswoman power! Yeah ♪",
            "audio": "resources/vo_card_cmn_00017_00017-5-uniq-0015-00_potential-002.acb/vo_card_cmn_00017_00017-5-uniq-0015-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Feel free to order as much as you like! With these shoes carrying trays is a breeze...",
            "audio": "resources/vo_card_cmn_00017_00017-5-uniq-0015-00_potential-003.acb/vo_card_cmn_00017_00017-5-uniq-0015-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Huh? Are you trying to order from another person that’s not me? Huh? HUH?",
            "audio": "resources/vo_card_cmn_00017_00017-5-uniq-0015-00_potential-004.acb/vo_card_cmn_00017_00017-5-uniq-0015-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Thanks for ordering so much. I hope you order from me again... ‘Cause if I not...I’ll look for you.",
            "audio": "resources/vo_card_cmn_00017_00017-5-uniq-0015-00_potential-005.acb/vo_card_cmn_00017_00017-5-uniq-0015-00_potential-005.mp3"
        }
    ],
