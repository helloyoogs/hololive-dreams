    "voicelines": [
        {
            "type": "card_get",
            "text": "It may be hot, but not too hot for the fluff!\nGet ready, BAU BAU!",
            "audio": "resources/vo_live_dial_card_04017_04017-5-uniq-0080-00_myself.acb/vo_live_dial_card_04017_04017-5-uniq-0080-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Hey! What shall we do next?\nWe still haven't doggy paddle raced in the water yet, and we've got sand castles to make... Oh, and we gotta go out and find some pretty shells, and...\nHuh? Beach volleyball? Hey, nice! And Lui-nee-senpai and Fuwawa are here too so we can all play together!\nOh, hey... Where did our ball go? Oh noe! It's floating away in the water!\nOkay, leave it to me! For I have...a donut floatie!\nCome on! Push me in my donut floatie out to sea! Quickly now!\nHere I come, ball! Just a little closer... Got you! BAU BAU!",
            "audio": "resources/vo_card_cmn_04017_04017-5-uniq-0080-00_situation.acb/vo_card_cmn_04017_04017-5-uniq-0080-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "I'm a mer-puppy! BAU BAU!",
            "audio": "resources/vo_live_cmn_card_04017_04017-5-uniq-0080-00_skill-card.acb/vo_live_cmn_card_04017_04017-5-uniq-0080-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Uugh... stop staring so much!... But does my swimsuit look good on me?",
            "audio": "resources/vo_card_cmn_04017_04017-5-uniq-0080-00_potential-001.acb/vo_card_cmn_04017_04017-5-uniq-0080-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Throw! Spike! Phew, that was a great beach volleyball mental workout!",
            "audio": "resources/vo_card_cmn_04017_04017-5-uniq-0080-00_potential-002.acb/vo_card_cmn_04017_04017-5-uniq-0080-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Take that! And that! WATER FIGHT! Get soaked! BAU BAU!",
            "audio": "resources/vo_card_cmn_04017_04017-5-uniq-0080-00_potential-003.acb/vo_card_cmn_04017_04017-5-uniq-0080-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Heehee, watch out my little beach napper... You're getting buried in sand!",
            "audio": "resources/vo_card_cmn_04017_04017-5-uniq-0080-00_potential-004.acb/vo_card_cmn_04017_04017-5-uniq-0080-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Let's go shell hunting before we go! And then you can give me all the pretty ones!",
            "audio": "resources/vo_card_cmn_04017_04017-5-uniq-0080-00_potential-005.acb/vo_card_cmn_04017_04017-5-uniq-0080-00_potential-005.mp3"
        }
    ],
