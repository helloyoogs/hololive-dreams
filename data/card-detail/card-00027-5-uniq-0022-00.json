    "voicelines": [
        {
            "type": "card_get",
            "text": "Thanks a mill, groupies! Let's keep it free and easy!",
            "audio": "resources/vo_live_dial_card_00027_00027-5-uniq-0022-00_myself.acb/vo_live_dial_card_00027_00027-5-uniq-0022-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Yess!! Number 1, baby! You see that?!\nThat was insane, right? You've never seen god-tier aiming like that before!\nHow'd you do? Hey, not bad!\nYou said this was your first time, right? You're killing it!\nPhew! Okay let's take a breather and then jump right back in!\nYou and I are gonna dominate every last leaderboard!",
            "audio": "resources/vo_card_cmn_00027_00027-5-uniq-0022-00_situation.acb/vo_card_cmn_00027_00027-5-uniq-0022-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Succumb to my eternal darkness!",
            "audio": "resources/vo_live_cmn_card_00027_00027-5-uniq-0022-00_skill-card.acb/vo_live_cmn_card_00027_00027-5-uniq-0022-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Hey! I'm totally rocking this outfit, right?",
            "audio": "resources/vo_card_cmn_00027_00027-5-uniq-0022-00_potential-001.acb/vo_card_cmn_00027_00027-5-uniq-0022-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "What're you staring at? You're asking for a fine!",
            "audio": "resources/vo_card_cmn_00027_00027-5-uniq-0022-00_potential-002.acb/vo_card_cmn_00027_00027-5-uniq-0022-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Oh you wanna play games do you? Bring it on!",
            "audio": "resources/vo_card_cmn_00027_00027-5-uniq-0022-00_potential-003.acb/vo_card_cmn_00027_00027-5-uniq-0022-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "GG! Have some water. Let's play again soon.",
            "audio": "resources/vo_card_cmn_00027_00027-5-uniq-0022-00_potential-004.acb/vo_card_cmn_00027_00027-5-uniq-0022-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Thanks for always hanging out... It's...fun.",
