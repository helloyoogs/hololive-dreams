    "voicelines": [
        {
            "type": "card_get",
            "text": "Let's Biboo tax them all! Kira Kira Koseki♪",
            "audio": "resources/vo_live_dial_card_04014_04014-5-uniq-0053-00_myself.acb/vo_live_dial_card_04014_04014-5-uniq-0053-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Ta-daah! Sooo many sparkles, right?\nBiboo found this place all by herself! Pretty awesome, right? Go on, admit it!\nReally?! Yaaay, Biboo did it! Ehehe~\nNow can you pat my head to reward me, pleaaase?!\nThat feels sooo nice! Oh, and hey! This place?\nYou can't tell anyone about it, okay? It's a secret~!\nIt's OUR super special kira kira place!\nSo if you tell anyone...\nYou're gonna get it! Ahahaha!",
            "audio": "resources/vo_card_cmn_04014_04014-5-uniq-0053-00_situation.acb/vo_card_cmn_04014_04014-5-uniq-0053-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Pebbles, let's go!",
            "audio": "resources/vo_live_cmn_card_04014_04014-5-uniq-0053-00_skill-card.acb/vo_live_cmn_card_04014_04014-5-uniq-0053-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Biboo's a princess, for sure!\nDo I look cute in this?",
            "audio": "resources/vo_card_cmn_04014_04014-5-uniq-0053-00_potential-001.acb/vo_card_cmn_04014_04014-5-uniq-0053-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Let's play tag! Okay, Biboo's \"it!\"\nYou'd better be ready, hahaha! ",
            "audio": "resources/vo_card_cmn_04014_04014-5-uniq-0053-00_potential-002.acb/vo_card_cmn_04014_04014-5-uniq-0053-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Biboo's tummy is rumbling...\nHey hey, give me some snacks! Hurry up~!",
            "audio": "resources/vo_card_cmn_04014_04014-5-uniq-0053-00_potential-003.acb/vo_card_cmn_04014_04014-5-uniq-0053-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Boo! Surprised?\nNo more time to rest for you! Ahahaha!",
            "audio": "resources/vo_card_cmn_04014_04014-5-uniq-0053-00_potential-004.acb/vo_card_cmn_04014_04014-5-uniq-0053-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "If I find more pretty sparkles,\nI'll show you! So, look forward to it!",
            "audio": "resources/vo_card_cmn_04014_04014-5-uniq-0053-00_potential-005.acb/vo_card_cmn_04014_04014-5-uniq-0053-00_potential-005.mp3"
        }
    ],
