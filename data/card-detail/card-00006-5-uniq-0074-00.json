    "voicelines": [
        {
            "type": "card_get",
            "text": "Hi Friends! Let's make memories that can only be created during summer together!",
            "audio": "resources/vo_live_dial_card_00006_00006-5-uniq-0074-00_myself.acb/vo_live_dial_card_00006_00006-5-uniq-0074-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Heaven! Absolute heaven, I tell you! The cold ocean water feels so good...♪\nOh! And thank you for inviting me today! I'm gonna enjoy the ocean to the fullest!\nShould we start with the basics then? We can always splash water at each other, or we can continue lazing away here...\nYou what? You want to have a RACE on the beach?!\nYou know who you are asking, right? I survived THAT jungle, ya know? Hehe... I’ll accept your challenge!\nOn the count of three... UOOHHHH!!! LIKE HELL I’LL LOOOOOOSE!",
            "audio": "resources/vo_card_cmn_00006_00006-5-uniq-0074-00_situation.acb/vo_card_cmn_00006_00006-5-uniq-0074-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Kon Kon SPLAAASH!",
            "audio": "resources/vo_live_cmn_card_00006_00006-5-uniq-0074-00_skill-card.acb/vo_live_cmn_card_00006_00006-5-uniq-0074-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Eheheh, what do you think? It's my swimsuit! Aren't you staring way too much?!",
            "audio": "resources/vo_card_cmn_00006_00006-5-uniq-0074-00_potential-001.acb/vo_card_cmn_00006_00006-5-uniq-0074-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Hah hah... Dammit, I lost again! You run so fast I can’t keep up!",
            "audio": "resources/vo_card_cmn_00006_00006-5-uniq-0074-00_potential-002.acb/vo_card_cmn_00006_00006-5-uniq-0074-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Is that Ramune?! And it’s for me? What a lifesaver! My throat is completely parched...",
            "audio": "resources/vo_card_cmn_00006_00006-5-uniq-0074-00_potential-003.acb/vo_card_cmn_00006_00006-5-uniq-0074-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Ehehe~ Ramune~♪ Shake it a bit...and heads up! Delish!",
            "audio": "resources/vo_card_cmn_00006_00006-5-uniq-0074-00_potential-004.acb/vo_card_cmn_00006_00006-5-uniq-0074-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Hey, hey, wanna go back in? This time we can float around lazily on a floatie or something~♪",
            "audio": "resources/vo_card_cmn_00006_00006-5-uniq-0074-00_potential-005.acb/vo_card_cmn_00006_00006-5-uniq-0074-00_potential-005.mp3"
        }
    ],
