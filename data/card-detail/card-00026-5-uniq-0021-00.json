    "voicelines": [
        {
            "type": "card_get",
            "text": "Thank you! \nYou'll keep making dreams come true with me, right?",
            "audio": "resources/vo_live_dial_card_00026_00026-5-uniq-0021-00_myself.acb/vo_live_dial_card_00026_00026-5-uniq-0021-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Welcome to Watame’s concert~ ♪ Are you enjoying it? Getting hyped? Are you feeling the Watavibes?\nWhat amazing cheer power! Everyone's expressions are shining just like the sun ♪\nSeeing everyone’s smiles makes me teary... But no, no! It’s TOO soon to cry!\nAfter all, the concert has just begun! Alright, everyone, are you ready?\nLet’s unite our hearts together as one! We’re gonna have fun and become one big, big family!",
            "audio": "resources/vo_card_cmn_00026_00026-5-uniq-0021-00_situation.acb/vo_card_cmn_00026_00026-5-uniq-0021-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "It's a never-ending do do do drive!",
            "audio": "resources/vo_live_cmn_card_00026_00026-5-uniq-0021-00_skill-card.acb/vo_live_cmn_card_00026_00026-5-uniq-0021-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Do you like this outfit? It’s all so fluffy and cute...just like me!",
            "audio": "resources/vo_card_cmn_00026_00026-5-uniq-0021-00_potential-001.acb/vo_card_cmn_00026_00026-5-uniq-0021-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "There’s so many green in this, its like an all-you-can-eat buffet of green!",
            "audio": "resources/vo_card_cmn_00026_00026-5-uniq-0021-00_potential-002.acb/vo_card_cmn_00026_00026-5-uniq-0021-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Raise both hands~ Swing them left and right~ Then stretch them both and get pumped!",
            "audio": "resources/vo_card_cmn_00026_00026-5-uniq-0021-00_potential-003.acb/vo_card_cmn_00026_00026-5-uniq-0021-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Wh-What an incredible sense of unity! Is this the power of our bond?",
            "audio": "resources/vo_card_cmn_00026_00026-5-uniq-0021-00_potential-004.acb/vo_card_cmn_00026_00026-5-uniq-0021-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "No one can take anyone's place! Everyone is an important part of Watame’s family!",
            "audio": "resources/vo_card_cmn_00026_00026-5-uniq-0021-00_potential-005.acb/vo_card_cmn_00026_00026-5-uniq-0021-00_potential-005.mp3"
        }
    ],
