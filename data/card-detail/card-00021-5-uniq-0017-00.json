    "voicelines": [
        {
            "type": "card_get",
            "text": "Thank you so much for supporting me. \nI'm so glad we met, and I love you all.",
            "audio": "resources/vo_live_dial_card_00021_00021-5-uniq-0017-00_myself.acb/vo_live_dial_card_00021_00021-5-uniq-0017-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Um, thank you for joining us here today on a boat tour of the island oceanic sights. I’ll be your guide, Shiranui Flare.\nHow was that? Pretty convincing? So, the boat will soon pass under the bridge coming up ahead...\nHuh? We stopped. Did paddling wear you out?\nSorry, sorry. I left you in charge of it, I’ll tag in for you.\nIn exchange, can you guide in my place for me? Hehehe.\nOh, you wanna paddle instead? Shame, I wanted to see act as my guide, hahaha.",
            "audio": "resources/vo_card_cmn_00021_00021-5-uniq-0017-00_situation.acb/vo_card_cmn_00021_00021-5-uniq-0017-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Crank the volume! This is my song, and it's only just begun!",
            "audio": "resources/vo_live_cmn_card_00021_00021-5-uniq-0017-00_skill-card.acb/vo_live_cmn_card_00021_00021-5-uniq-0017-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "What do you think of my outfit, today? It’s frilly and cute, right?",
            "audio": "resources/vo_card_cmn_00021_00021-5-uniq-0017-00_potential-001.acb/vo_card_cmn_00021_00021-5-uniq-0017-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "A pigeon is here! I wonder, did they come to greet us?",
            "audio": "resources/vo_card_cmn_00021_00021-5-uniq-0017-00_potential-002.acb/vo_card_cmn_00021_00021-5-uniq-0017-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Oh, look in the water... Oh! That was close, I leaned out too far!",
            "audio": "resources/vo_card_cmn_00021_00021-5-uniq-0017-00_potential-003.acb/vo_card_cmn_00021_00021-5-uniq-0017-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Hey, let's head toward town when we disembark. I still want to go sightseeing together.",
            "audio": "resources/vo_card_cmn_00021_00021-5-uniq-0017-00_potential-004.acb/vo_card_cmn_00021_00021-5-uniq-0017-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Let’s go look at more landscapes. We already promised we would, right?",
            "audio": "resources/vo_card_cmn_00021_00021-5-uniq-0017-00_potential-005.acb/vo_card_cmn_00021_00021-5-uniq-0017-00_potential-005.mp3"
        }
    ],
