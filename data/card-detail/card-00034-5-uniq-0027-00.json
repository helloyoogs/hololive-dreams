    "voicelines": [
        {
            "type": "card_get",
            "text": "You think I'm cool up here? \nYou're like a thousand times cooler for coming to see me!",
            "audio": "resources/vo_live_dial_card_00034_00034-5-uniq-0027-00_myself.acb/vo_live_dial_card_00034_00034-5-uniq-0027-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Yo yo! How's it going? Welcome to Polka's circus!\nWho's ready to have a roaring good time? I've got some wicked sick illusions for you today!\nWhat sort? Oh my, dear guest. You're not supposed to ask me that!\nA gift is only exciting because of the lead-up to it, right? The same with tricks!\nSo you'll just have to wait and see. I promise it'll be a night to remember!\nAnd do you hear that? It's...showtime!",
            "audio": "resources/vo_card_cmn_00034_00034-5-uniq-0027-00_situation.acb/vo_card_cmn_00034_00034-5-uniq-0027-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "I'm not about to let a little bad energy stop me!",
            "audio": "resources/vo_live_cmn_card_00034_00034-5-uniq-0027-00_skill-card.acb/vo_live_cmn_card_00034_00034-5-uniq-0027-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "And what do we have here in my hat? Why it's a...dove!",
            "audio": "resources/vo_card_cmn_00034_00034-5-uniq-0027-00_potential-001.acb/vo_card_cmn_00034_00034-5-uniq-0027-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Whoo! Crowd's gone wild! This is sick! So glad we did this.",
            "audio": "resources/vo_card_cmn_00034_00034-5-uniq-0027-00_potential-002.acb/vo_card_cmn_00034_00034-5-uniq-0027-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "What kind of circus shall I do next? Hey, what would you like to see?",
            "audio": "resources/vo_card_cmn_00034_00034-5-uniq-0027-00_potential-003.acb/vo_card_cmn_00034_00034-5-uniq-0027-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "You'll come watch me next time, right? Right?! You know what happens when you don't come and watch me...",
            "audio": "resources/vo_card_cmn_00034_00034-5-uniq-0027-00_potential-004.acb/vo_card_cmn_00034_00034-5-uniq-0027-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Thank y'all for supporting Polka! I'm gonna make it smiles all round!",
            "audio": "resources/vo_card_cmn_00034_00034-5-uniq-0027-00_potential-005.acb/vo_card_cmn_00034_00034-5-uniq-0027-00_potential-005.mp3"
        }
    ],
