    "voicelines": [
        {
            "type": "card_get",
            "text": "From here on out, I'll keep making countless smiles bloom! \nEveryone, follow my lead!",
            "audio": "resources/vo_live_dial_card_00015_00015-5-uniq-0003-00_myself.acb/vo_live_dial_card_00015_00015-5-uniq-0003-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "W-Whoa! The cherry blossoms are in full bloom... And they're all Miko's color!\nYou wanted me to see it! And here I was thinking you wanted to go shrine hopping all of a sudden.\nWell, isn't this a nice surprise! Hey, I'm not crying, you are! Teehee!\nWell, seeing as we're here, let's go sit under the flowers! Under their radiant and dazzling blooms.\nAh! Pahahaha! You've got a petal on your head. No, a bit more to the right...\nOh, here. Let me just get it for you. Hold still... Okay, got it!",
            "audio": "resources/vo_card_cmn_00015_00015-5-uniq-0003-00_situation.acb/vo_card_cmn_00015_00015-5-uniq-0003-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Is that a serious face? Not for long!",
            "audio": "resources/vo_live_cmn_card_00015_00015-5-uniq-0003-00_skill-card.acb/vo_live_cmn_card_00015_00015-5-uniq-0003-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Check me out! Outfit in full bloom!",
            "audio": "resources/vo_card_cmn_00015_00015-5-uniq-0003-00_potential-001.acb/vo_card_cmn_00015_00015-5-uniq-0003-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Miko's elite levels are goin' on up! Well come on, say something!",
            "audio": "resources/vo_card_cmn_00015_00015-5-uniq-0003-00_potential-002.acb/vo_card_cmn_00015_00015-5-uniq-0003-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Ey! Ain't nobody gonna call Miko a baby now!",
            "audio": "resources/vo_card_cmn_00015_00015-5-uniq-0003-00_potential-003.acb/vo_card_cmn_00015_00015-5-uniq-0003-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Ooh, look at you! You're just infatuated with me!",
            "audio": "resources/vo_card_cmn_00015_00015-5-uniq-0003-00_potential-004.acb/vo_card_cmn_00015_00015-5-uniq-0003-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "I've got a place for us next time we go out. It's a date!",
            "audio": "resources/vo_card_cmn_00015_00015-5-uniq-0003-00_potential-005.acb/vo_card_cmn_00015_00015-5-uniq-0003-00_potential-005.mp3"
        }
    ],
