    "voicelines": [
        {
            "type": "card_get",
            "text": "I'll keep training, keep levelling, \nso we can all reach peak joy!",
            "audio": "resources/vo_live_dial_card_00022_00022-5-uniq-0018-00_myself.acb/vo_live_dial_card_00022_00022-5-uniq-0018-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Wah, are you okay?! You must be shocked to suddenly trip like that?\nYou’re not injured, right? ...Yeah, you seem to be fine.\nGood! That’s a relief. Oh, but your knee is turning red.\nIn times like this... There, there. See, makes the pain all go away!\nHehehe... Now just stand back up!\nHere, take Dancho’s hand. You can put your weight on me.\n...And there you go! Wh-Wh-What?! Oh dear... Now Dancho fell over too LOL",
            "audio": "resources/vo_card_cmn_00022_00022-5-uniq-0018-00_situation.acb/vo_card_cmn_00022_00022-5-uniq-0018-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Let's do this!",
            "audio": "resources/vo_live_cmn_card_00022_00022-5-uniq-0018-00_skill-card.acb/vo_live_cmn_card_00022_00022-5-uniq-0018-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "How's this outfit? Does it make your Dancho look tough?",
            "audio": "resources/vo_card_cmn_00022_00022-5-uniq-0018-00_potential-001.acb/vo_card_cmn_00022_00022-5-uniq-0018-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Next time you feel you’re about to fall over, bring your foot out and plant it firmly on the ground!",
            "audio": "resources/vo_card_cmn_00022_00022-5-uniq-0018-00_potential-002.acb/vo_card_cmn_00022_00022-5-uniq-0018-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Oh, wow! You’ve walked a distance but you’re still full of energy! Nice stamina.",
            "audio": "resources/vo_card_cmn_00022_00022-5-uniq-0018-00_potential-003.acb/vo_card_cmn_00022_00022-5-uniq-0018-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Eh, you’re giving Dancho water? Thanks! This will blow away the aches!",
            "audio": "resources/vo_card_cmn_00022_00022-5-uniq-0018-00_potential-004.acb/vo_card_cmn_00022_00022-5-uniq-0018-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Thanks accompanying on a walk today! Let’s go again some time!",
            "audio": "resources/vo_card_cmn_00022_00022-5-uniq-0018-00_potential-005.acb/vo_card_cmn_00022_00022-5-uniq-0018-00_potential-005.mp3"
        }
    ],
