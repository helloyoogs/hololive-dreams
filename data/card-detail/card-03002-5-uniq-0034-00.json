    "voicelines": [
        {
            "type": "card_get",
            "text": "Thank you, everyone. \nYour collective support allows me to glow.",
            "audio": "resources/vo_live_dial_card_03002_03002-5-uniq-0034-00_myself.acb/vo_live_dial_card_03002_03002-5-uniq-0034-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Attention, mortals! The Moon Goddess has graced you with her presence! On your knees, peasants!\nJust kidding!♪ Everyone, thank you for coming to Moona's live today!\nLet's enjoy it together until the end!\nWell then, it's about time...for the Moon Goddess to descend to Earth!\n...Huh? Hey, why am I not coming down?!\n...Oh. Right! I was supposed to start singing up here first.\nW-well, let's start over. Music, start!",
            "audio": "resources/vo_card_cmn_03002_03002-5-uniq-0034-00_situation.acb/vo_card_cmn_03002_03002-5-uniq-0034-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "It's Moona dayo~♪",
            "audio": "resources/vo_live_cmn_card_03002_03002-5-uniq-0034-00_skill-card.acb/vo_live_cmn_card_03002_03002-5-uniq-0034-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Check me out, adorned with starry sky. Pretty cool, right? Hehe~",
            "audio": "resources/vo_card_cmn_03002_03002-5-uniq-0034-00_potential-001.acb/vo_card_cmn_03002_03002-5-uniq-0034-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Alright, time for a moonwalk. Wheee~ ♪",
            "audio": "resources/vo_card_cmn_03002_03002-5-uniq-0034-00_potential-002.acb/vo_card_cmn_03002_03002-5-uniq-0034-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "I'm like a different person when singing? Hey now! What are you implying about my usual self?!",
            "audio": "resources/vo_card_cmn_03002_03002-5-uniq-0034-00_potential-003.acb/vo_card_cmn_03002_03002-5-uniq-0034-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Ehehe, singing is really fun after all~♪ I wish this moment could last forever!",
            "audio": "resources/vo_card_cmn_03002_03002-5-uniq-0034-00_potential-004.acb/vo_card_cmn_03002_03002-5-uniq-0034-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "I was nervous at first, but your cheers kept me going. From the bottom of my heart, thank you...",
            "audio": "resources/vo_card_cmn_03002_03002-5-uniq-0034-00_potential-005.acb/vo_card_cmn_03002_03002-5-uniq-0034-00_potential-005.mp3"
        }
    ],
