    "voicelines": [
        {
            "type": "card_get",
            "text": "Gonna party with us until the very end? \nEhehe, it’ll be our summer promise!",
            "audio": "resources/vo_live_dial_card_00010_00010-5-uniq-0069-00_myself.acb/vo_live_dial_card_00010_00010-5-uniq-0069-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Ahhh... This feels so good!\nI went to the beach the other day, and there's just nothing like lying on a float.\n*sigh* I could laze around forever...\nHm? Shaved ice? ...Shaved ice?! Of course I'll eat it! Let’s go get some!\nGah... Ugh, this float just won't move! This is so annoying!\n...Eh? Oh, I know! I can just get off the float and walk!\nEhehe... And off. Okay, let’s go!",
            "audio": "resources/vo_card_cmn_00010_00010-5-uniq-0069-00_situation.acb/vo_card_cmn_00010_00010-5-uniq-0069-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Summer is all about sun and swimsuits!",
            "audio": "resources/vo_live_cmn_card_00010_00010-5-uniq-0069-00_skill-card.acb/vo_live_cmn_card_00010_00010-5-uniq-0069-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "How's my swimsuit? Does it suit me? ...Ehehe, thanks!",
            "audio": "resources/vo_card_cmn_00010_00010-5-uniq-0069-00_potential-001.acb/vo_card_cmn_00010_00010-5-uniq-0069-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Wow, shaved ice! Hm... Aaaah! Brain freeze!",
            "audio": "resources/vo_card_cmn_00010_00010-5-uniq-0069-00_potential-002.acb/vo_card_cmn_00010_00010-5-uniq-0069-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Hey, wait! I just realised... If you inflate a beach ball, it becomes a pillow...",
            "audio": "resources/vo_card_cmn_00010_00010-5-uniq-0069-00_potential-003.acb/vo_card_cmn_00010_00010-5-uniq-0069-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "*pants* It’s not inflating at all... Eh? ...There’s a pump?! Why didn't you say so?!",
            "audio": "resources/vo_card_cmn_00010_00010-5-uniq-0069-00_potential-004.acb/vo_card_cmn_00010_00010-5-uniq-0069-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "I did it... Hey, hey, let's grab a beach ball and go bob it around!",
            "audio": "resources/vo_card_cmn_00010_00010-5-uniq-0069-00_potential-005.acb/vo_card_cmn_00010_00010-5-uniq-0069-00_potential-005.mp3"
        }
    ],
