    "voicelines": [
        {
            "type": "card_get",
            "text": "I'll keep going, and if you'll keep giving me your support, \nthat's all I need!",
            "audio": "resources/vo_live_dial_card_00018_00018-5-uniq-0004-00_myself.acb/vo_live_dial_card_00018_00018-5-uniq-0004-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Time flies when you're having fun! It's sad it has to end, but this is the last song!\nThanks to all of you, we had such a great show!\nAll those penlights waving in the dark makes the hall look like a starry night sky!\nEvery single one of you is a shining star to me! I want my voice to reach all of you!\nDon't take your eyes off me! I'll show you just how bright I can shine!\nI don't want to hear that I was too bright to see, okay?",
            "audio": "resources/vo_card_cmn_00018_00018-5-uniq-0004-00_situation.acb/vo_card_cmn_00018_00018-5-uniq-0004-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "C'mon, are you feeling it?",
            "audio": "resources/vo_live_cmn_card_00018_00018-5-uniq-0004-00_skill-card.acb/vo_live_cmn_card_00018_00018-5-uniq-0004-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "I'm loving the cool colors. Aren't they great?",
            "audio": "resources/vo_card_cmn_00018_00018-5-uniq-0004-00_potential-001.acb/vo_card_cmn_00018_00018-5-uniq-0004-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Sparkle sparkle!☆ I'm shining super bright, wrapped in the night sky!",
            "audio": "resources/vo_card_cmn_00018_00018-5-uniq-0004-00_potential-002.acb/vo_card_cmn_00018_00018-5-uniq-0004-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Hydration is important! Let's work towards our goals together!",
            "audio": "resources/vo_card_cmn_00018_00018-5-uniq-0004-00_potential-003.acb/vo_card_cmn_00018_00018-5-uniq-0004-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Are you ready, everyone? Scream loud enough to reach the stars!",
            "audio": "resources/vo_card_cmn_00018_00018-5-uniq-0004-00_potential-004.acb/vo_card_cmn_00018_00018-5-uniq-0004-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Thank you for coming today! I'll keep singing my heart out for you!",
            "audio": "resources/vo_card_cmn_00018_00018-5-uniq-0004-00_potential-005.acb/vo_card_cmn_00018_00018-5-uniq-0004-00_potential-005.mp3"
        }
    ],
