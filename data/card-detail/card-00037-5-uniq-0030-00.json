    "voicelines": [
        {
            "type": "card_get",
            "text": "No reaction in the universe could tear us apart! \nI love you so much!",
            "audio": "resources/vo_live_dial_card_00037_00037-5-uniq-0030-00_myself.acb/vo_live_dial_card_00037_00037-5-uniq-0030-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Whoa! How's everyone?!\nThanks for coming~♪\n...Hmph! I can't hear you~\nNeeds more Koyorium, I'd say~\nOh, no! More supplies! MORE SUPPLIES!\nGive you Koyorium sickness,\nKoyo always on your mind~♪\nA plan worthy of the brains of holoX!\nSo, here's some fresh Koyorium!\nLove yooou! ♡ Mm-wah! ♡",
            "audio": "resources/vo_card_cmn_00037_00037-5-uniq-0030-00_situation.acb/vo_card_cmn_00037_00037-5-uniq-0030-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Substantiated with evidence. Q.E.D.",
            "audio": "resources/vo_live_cmn_card_00037_00037-5-uniq-0030-00_skill-card.acb/vo_live_cmn_card_00037_00037-5-uniq-0030-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "This outfit is...\nZuno! Cute pink and white♪",
            "audio": "resources/vo_card_cmn_00037_00037-5-uniq-0030-00_potential-001.acb/vo_card_cmn_00037_00037-5-uniq-0030-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Inside Mr. Assistant's pouch is...\nKoyo love?",
            "audio": "resources/vo_card_cmn_00037_00037-5-uniq-0030-00_potential-002.acb/vo_card_cmn_00037_00037-5-uniq-0030-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Try until you get results! Go for it!",
            "audio": "resources/vo_card_cmn_00037_00037-5-uniq-0030-00_potential-003.acb/vo_card_cmn_00037_00037-5-uniq-0030-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Break time?\nSit next to me, maybe?",
