    "voicelines": [
        {
            "type": "card_get",
            "text": "Let’s enjoy summer together this year, \nand the next, and also the one after that!",
            "audio": "resources/vo_live_dial_card_00022_00022-5-uniq-0063-00_myself.acb/vo_live_dial_card_00022_00022-5-uniq-0063-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Heeeey, what are you doing? Come over here and let’s take a dip in the sea!\nAh, there you are! Here, sit. Feels nice, right?\nEverytime the waves come at me, I feel like it's tickling my waists!♪\nI was moving around a lot last time, so it’s also nice to take it easy like this, too~♪\nWha..? Whooooa!\nOh, that wave crashed right over my head... Hehehe, I'm completely soaked.\nWell, now that's happened... Why don’t we have a water fight~?",
            "audio": "resources/vo_card_cmn_00022_00022-5-uniq-0063-00_situation.acb/vo_card_cmn_00022_00022-5-uniq-0063-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Look at the Dancho summer dance steps!",
            "audio": "resources/vo_live_cmn_card_00022_00022-5-uniq-0063-00_skill-card.acb/vo_live_cmn_card_00022_00022-5-uniq-0063-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "You are staring at me so much! Do you perhaps like my swimsuit look?",
            "audio": "resources/vo_card_cmn_00022_00022-5-uniq-0063-00_potential-001.acb/vo_card_cmn_00022_00022-5-uniq-0063-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "My speed is boosted in the swimsuit! Look at my steps! Yay, yay, yaaay!",
            "audio": "resources/vo_card_cmn_00022_00022-5-uniq-0063-00_potential-002.acb/vo_card_cmn_00022_00022-5-uniq-0063-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "A soft serve ice cream at the beach is just something else. Oh, no! It will spill!",
            "audio": "resources/vo_card_cmn_00022_00022-5-uniq-0063-00_potential-003.acb/vo_card_cmn_00022_00022-5-uniq-0063-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Hey, hey! Let’s lie on a floaty and just drift around.",
            "audio": "resources/vo_card_cmn_00022_00022-5-uniq-0063-00_potential-004.acb/vo_card_cmn_00022_00022-5-uniq-0063-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Lying down like this makes us really close. Kind of exciting, hehe.",
            "audio": "resources/vo_card_cmn_00022_00022-5-uniq-0063-00_potential-005.acb/vo_card_cmn_00022_00022-5-uniq-0063-00_potential-005.mp3"
        }
    ],
