    "voicelines": [
        {
            "type": "card_get",
            "text": "Wanna fall into a fleeting summer love with me? Nah... Just kidding!♡",
            "audio": "resources/vo_live_dial_card_00016_00016-5-uniq-0076-00_myself.acb/vo_live_dial_card_00016_00016-5-uniq-0076-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "I survived a deserted island...only to lose to a simple summer beach sun... *thud*\nKidding, kidding, I’m fine.\nMore importantly, how’s my swimsuit? Does it make your heart race?\nThose are some nice eyes! They’re saying “Okayu’s swimsuit is supreme!”\nCome on, I can tell even if you try to hide it~♪\nIt’s just a shame, though... Had you told me, I would’ve asked you to rub some sunscreen on me~♪\nMaaaybe... I’ll just put it on myself? What should I do, hmm?\nAhaha, you’re getting flustered from just a little tease? Perhaps...you secretly like being teased...♪",
            "audio": "resources/vo_card_cmn_00016_00016-5-uniq-0076-00_situation.acb/vo_card_cmn_00016_00016-5-uniq-0076-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Nyaning on the beach~♪",
            "audio": "resources/vo_live_cmn_card_00016_00016-5-uniq-0076-00_skill-card.acb/vo_live_cmn_card_00016_00016-5-uniq-0076-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "In reality, these paw prints in my swimsuit are touching me from the inside.♡ Just kidding!",
            "audio": "resources/vo_card_cmn_00016_00016-5-uniq-0076-00_potential-001.acb/vo_card_cmn_00016_00016-5-uniq-0076-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Are you the type who gets excited seeing tan lines after summer break?",
            "audio": "resources/vo_card_cmn_00016_00016-5-uniq-0076-00_potential-002.acb/vo_card_cmn_00016_00016-5-uniq-0076-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Where do you think you’re looking at, you naughty! ...There, I figured you wanted me to say it.♡",
            "audio": "resources/vo_card_cmn_00016_00016-5-uniq-0076-00_potential-003.acb/vo_card_cmn_00016_00016-5-uniq-0076-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Time for some ol’ watermelon splitting! Where is it? Where is it? Is it over here? YAAH!",
            "audio": "resources/vo_card_cmn_00016_00016-5-uniq-0076-00_potential-004.acb/vo_card_cmn_00016_00016-5-uniq-0076-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "How was your summer beach trip with me? Have you fallen for me yet?",
            "audio": "resources/vo_card_cmn_00016_00016-5-uniq-0076-00_potential-005.acb/vo_card_cmn_00016_00016-5-uniq-0076-00_potential-005.mp3"
        }
    ],
