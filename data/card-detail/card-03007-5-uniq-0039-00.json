    "voicelines": [
        {
            "type": "card_get",
            "text": "Nyahaha♪ How about I treat you guys to something special?\n",
            "audio": "resources/vo_live_dial_card_03007_03007-5-uniq-0039-00_myself.acb/vo_live_dial_card_03007_03007-5-uniq-0039-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Meow meow, wanna take a little nap on my lap? Geez, you're such a clingy kitty. So cute~\n...Huh, why are you staring at me like that? Could it be...you want to cuddle up to me like this kitty?\nToo bad! My lap is the kitty's special seat, so no can do~\nBut in exchange... I've got a cat wand! I'll give you some tickles with this~\nTickle tickle, tickle tickle~ Ahahaha! Hey, don't run away!",
            "audio": "resources/vo_card_cmn_03007_03007-5-uniq-0039-00_situation.acb/vo_card_cmn_03007_03007-5-uniq-0039-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "You're about to see what this agent can really do!",
            "audio": "resources/vo_live_cmn_card_03007_03007-5-uniq-0039-00_skill-card.acb/vo_live_cmn_card_03007_03007-5-uniq-0039-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "How is it? Zeta with off-shoulder style, cute... I mean, cool, right?",
            "audio": "resources/vo_card_cmn_03007_03007-5-uniq-0039-00_potential-001.acb/vo_card_cmn_03007_03007-5-uniq-0039-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Let's play rock-paper-scissors! The loser gets tickled! I'll throw scissors, so you throw paper, alright?",
            "audio": "resources/vo_card_cmn_03007_03007-5-uniq-0039-00_potential-002.acb/vo_card_cmn_03007_03007-5-uniq-0039-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Which kitty do you like? Huh, why are you looking at me... Wait! Don't treat me like a cat!",
            "audio": "resources/vo_card_cmn_03007_03007-5-uniq-0039-00_potential-003.acb/vo_card_cmn_03007_03007-5-uniq-0039-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Did you buy cat food for the kitties? Wow, nice! You're more reliable than I thought.",
            "audio": "resources/vo_card_cmn_03007_03007-5-uniq-0039-00_potential-004.acb/vo_card_cmn_03007_03007-5-uniq-0039-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Mission alert! Today you're staying to play with me the whole time! Got it?!",
            "audio": "resources/vo_card_cmn_03007_03007-5-uniq-0039-00_potential-005.acb/vo_card_cmn_03007_03007-5-uniq-0039-00_potential-005.mp3"
        }
    ],
