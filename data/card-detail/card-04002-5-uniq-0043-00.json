    "voicelines": [
        {
            "type": "card_get",
            "text": "Thanks for all your support! \nI love the holo Members and I love my KFPs!",
            "audio": "resources/vo_live_dial_card_04002_04002-5-uniq-0043-00_myself.acb/vo_live_dial_card_04002_04002-5-uniq-0043-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Kikkeriki! Here's our signature hamburger combo! Sorry for the wait!\n...So?  Quite generous portions, right~?\nEvery dish is made with my affection, so enjoy each bite! Bon appétiiiit~\n...Oh? Ah, my bad. Does it feel awkward to eat when someone's staring at you?\nHehe, I get it. But I really wanna see what kind of expression you'll make, you know?\nMind if I stick around? I wanna see your happy face!",
            "audio": "resources/vo_card_cmn_04002_04002-5-uniq-0043-00_situation.acb/vo_card_cmn_04002_04002-5-uniq-0043-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Kiwawa, activate!",
            "audio": "resources/vo_live_cmn_card_04002_04002-5-uniq-0043-00_skill-card.acb/vo_live_cmn_card_04002_04002-5-uniq-0043-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Welcome! You can spot me easily in this cute uniform. I'm here to help with anything you need.",
            "audio": "resources/vo_card_cmn_04002_04002-5-uniq-0043-00_potential-001.acb/vo_card_cmn_04002_04002-5-uniq-0043-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "This chicken was grilled in phoenix flames... I'm just messing with you!",
            "audio": "resources/vo_card_cmn_04002_04002-5-uniq-0043-00_potential-002.acb/vo_card_cmn_04002_04002-5-uniq-0043-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Wait, it's tasty?! Aww... I'm so glad you're enjoying it~",
            "audio": "resources/vo_card_cmn_04002_04002-5-uniq-0043-00_potential-003.acb/vo_card_cmn_04002_04002-5-uniq-0043-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Actually, we have have some special off-menu items~ Wanna try something exclusive?",
            "audio": "resources/vo_card_cmn_04002_04002-5-uniq-0043-00_potential-004.acb/vo_card_cmn_04002_04002-5-uniq-0043-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Leaving so soon? Stop by again sometime, okay? I'll be preparing lots of stuff and waiting for you~",
            "audio": "resources/vo_card_cmn_04002_04002-5-uniq-0043-00_potential-005.acb/vo_card_cmn_04002_04002-5-uniq-0043-00_potential-005.mp3"
        }
    ],
