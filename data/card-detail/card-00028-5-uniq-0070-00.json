    "voicelines": [
        {
            "type": "card_get",
            "text": "Let’s blow away the summer heat together, nora! \nReady, nora? Pfffft!",
            "audio": "resources/vo_live_dial_card_00028_00028-5-uniq-0070-00_myself.acb/vo_live_dial_card_00028_00028-5-uniq-0070-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Aaah, I’ve had plenty of time to relax. It’s time to play in the sea, nora!\nSo, could you inflate my float, nora.\n...Eh? There’s no air pump, nora? It's quite all right. A float of this size should be easy to inflate, nora?\nI’ve inflated a plastic pool before, so I can show you the trick, nora!\nLike this, nora? Then with all your might, puff out your cheeks and... Pfffffft! Got it, nora? Well, off you go, nora.",
            "audio": "resources/vo_card_cmn_00028_00028-5-uniq-0070-00_situation.acb/vo_card_cmn_00028_00028-5-uniq-0070-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Everlasting Summer Princess Time, nora!♪",
            "audio": "resources/vo_live_cmn_card_00028_00028-5-uniq-0070-00_skill-card.acb/vo_live_cmn_card_00028_00028-5-uniq-0070-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Ta-da! Isn't this swimsuit cute? Here comes the Summer Princess, nora!",
            "audio": "resources/vo_card_cmn_00028_00028-5-uniq-0070-00_potential-001.acb/vo_card_cmn_00028_00028-5-uniq-0070-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Floating in the sea like this sure is nice, nora! Mmmm...",
            "audio": "resources/vo_card_cmn_00028_00028-5-uniq-0070-00_potential-002.acb/vo_card_cmn_00028_00028-5-uniq-0070-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "You’re commendable for keeping a close eye on me and making sure I didn’t get whisked away, nora! A pat on the back for you, nora!",
            "audio": "resources/vo_card_cmn_00028_00028-5-uniq-0070-00_potential-003.acb/vo_card_cmn_00028_00028-5-uniq-0070-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Huh?! Did you just splash water on me, nora...? You! You! Come back here!",
            "audio": "resources/vo_card_cmn_00028_00028-5-uniq-0070-00_potential-004.acb/vo_card_cmn_00028_00028-5-uniq-0070-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Today was fun, nora! I’m glad we could make summer memories together, nora!",
            "audio": "resources/vo_card_cmn_00028_00028-5-uniq-0070-00_potential-005.acb/vo_card_cmn_00028_00028-5-uniq-0070-00_potential-005.mp3"
        }
    ],
