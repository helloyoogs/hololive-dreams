    "voicelines": [
        {
            "type": "card_get",
            "text": "Thanks for all of your love, please continue loving me, okay♪",
            "audio": "resources/vo_live_dial_card_04015_04015-5-uniq-0054-00_myself.acb/vo_live_dial_card_04015_04015-5-uniq-0054-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Welcome to Nerissa Ravencroft's opera extravaganza♡\nToday, I'll whisk you away to a world of enchantment♪ Don't you dare look away from me, okay?\n...Ah! Yes, that's it. Keep your eyes fixed on me like that!\nEveryone's intense gaze is making me feel weak in the knees~♡\n...Huh! I can't believe myself, I'm sorry. It seems I've gotten a bit flustered.\nFufu, well then, shall we begin? Prepare to be captivated by the voice of The Demon of Sound♡",
            "audio": "resources/vo_card_cmn_04015_04015-5-uniq-0054-00_situation.acb/vo_card_cmn_04015_04015-5-uniq-0054-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Listen to the melody of the Demon of Sound~♪",
            "audio": "resources/vo_live_cmn_card_04015_04015-5-uniq-0054-00_skill-card.acb/vo_live_cmn_card_04015_04015-5-uniq-0054-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "I'll be on my best behavior today... Heeey, you're staring at my legs too much~",
            "audio": "resources/vo_card_cmn_04015_04015-5-uniq-0054-00_potential-001.acb/vo_card_cmn_04015_04015-5-uniq-0054-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "What a relief to have finished singing...  Ah, my heart is still pounding...",
            "audio": "resources/vo_card_cmn_04015_04015-5-uniq-0054-00_potential-002.acb/vo_card_cmn_04015_04015-5-uniq-0054-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Did you enjoy my song? ...Well? Well? How was it?!",
            "audio": "resources/vo_card_cmn_04015_04015-5-uniq-0054-00_potential-003.acb/vo_card_cmn_04015_04015-5-uniq-0054-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "I've received numerous comments about the performance. I'm so happy everyone enjoyed it",
            "audio": "resources/vo_card_cmn_04015_04015-5-uniq-0054-00_potential-004.acb/vo_card_cmn_04015_04015-5-uniq-0054-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "You'll come see me again next time, won't you? Remember, you're not allowed to take your eyes off me~",
            "audio": "resources/vo_card_cmn_04015_04015-5-uniq-0054-00_potential-005.acb/vo_card_cmn_04015_04015-5-uniq-0054-00_potential-005.mp3"
        }
    ],
