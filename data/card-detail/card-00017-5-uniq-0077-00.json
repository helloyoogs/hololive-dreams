    "voicelines": [
        {
            "type": "card_get",
            "text": "Who's ready for summer? Come on! Let's make this place blow!",
            "audio": "resources/vo_live_dial_card_00017_00017-5-uniq-0077-00_myself.acb/vo_live_dial_card_00017_00017-5-uniq-0077-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "YAAAAAY! I don’t even need the ground ever again!\nAs long as I have this rope, I can go ANYWHERE!\nWanna see the secret techniques I learned in the jungle? YAHOOOO~~!\nHey, wait. Why did it stop? We’re supposed to gain momentum here and go \"Wheee\" when it goes \"Whaaa\"!\nOh... We are absolutely in no pinch right now. But just in case, could you close your eyes for me?\nIt’s not because I need to touch the ground or anything, honest!\nJust close them, pretty please?",
            "audio": "resources/vo_card_cmn_00017_00017-5-uniq-0077-00_situation.acb/vo_card_cmn_00017_00017-5-uniq-0077-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Summer Shibakiage Punching!",
            "audio": "resources/vo_live_cmn_card_00017_00017-5-uniq-0077-00_skill-card.acb/vo_live_cmn_card_00017_00017-5-uniq-0077-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "This swimsuit gives me ultimate speed! WAHAHAHAHA!!!",
            "audio": "resources/vo_card_cmn_00017_00017-5-uniq-0077-00_potential-001.acb/vo_card_cmn_00017_00017-5-uniq-0077-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Hey, hey! You think my swimsuit’s cute? YOU DO!? Thank yoooou~♪",
            "audio": "resources/vo_card_cmn_00017_00017-5-uniq-0077-00_potential-002.acb/vo_card_cmn_00017_00017-5-uniq-0077-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "The trick to moving on the rope is doing a \"Wheee\" when it goes \"Whaaa\", get it?",
            "audio": "resources/vo_card_cmn_00017_00017-5-uniq-0077-00_potential-003.acb/vo_card_cmn_00017_00017-5-uniq-0077-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "I’ve even made it to the end this time! Ah, but I also made it to end before, okay?",
            "audio": "resources/vo_card_cmn_00017_00017-5-uniq-0077-00_potential-004.acb/vo_card_cmn_00017_00017-5-uniq-0077-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "OKAY! Let’s go one last time! We could call this a rope-date, ya know?",
            "audio": "resources/vo_card_cmn_00017_00017-5-uniq-0077-00_potential-005.acb/vo_card_cmn_00017_00017-5-uniq-0077-00_potential-005.mp3"
        }
    ],
