    "voicelines": [
        {
            "type": "card_get",
            "text": "Summer hasn’t even started! Let’s get crazy!",
            "audio": "resources/vo_live_dial_card_03004_03004-5-uniq-0073-00_myself.acb/vo_live_dial_card_03004_03004-5-uniq-0073-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "So many fish! And the coral's super beautiful! Eveything is amazing!\nWow! This fish looks like me!\nAren’t you looking at me way too much?\nOh, I know you are captivated by my swimsuit body but... Oh my! ♡\nYou know, I bought this swimsuit with my senpai and...\nWait, that’s not it, right? Ahaha! Sorry, sorry! We were talking about the underwater speed swimming match!\nLet’s do this! On your marks... GOOOOOOOOOO!",
            "audio": "resources/vo_card_cmn_03004_03004-5-uniq-0073-00_situation.acb/vo_card_cmn_03004_03004-5-uniq-0073-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "C-C-C-CRAZY HOT SUMMER!",
            "audio": "resources/vo_live_cmn_card_03004_03004-5-uniq-0073-00_skill-card.acb/vo_live_cmn_card_03004_03004-5-uniq-0073-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Swimsuit zombie ON STAGE! It looks good on me, right? You think so too, RIGHT?",
            "audio": "resources/vo_card_cmn_03004_03004-5-uniq-0073-00_potential-001.acb/vo_card_cmn_03004_03004-5-uniq-0073-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "My leg came off! AHHHHH! I'm sinking in the water! WAIT FOR ME!!",
            "audio": "resources/vo_card_cmn_03004_03004-5-uniq-0073-00_potential-002.acb/vo_card_cmn_03004_03004-5-uniq-0073-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Next up is underwater tag. After that, let’s have an underwater stare contests! LET'S GO!",
            "audio": "resources/vo_card_cmn_03004_03004-5-uniq-0073-00_potential-003.acb/vo_card_cmn_03004_03004-5-uniq-0073-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "We definitely need a break. Wanna chill with me on the floatie?",
            "audio": "resources/vo_card_cmn_03004_03004-5-uniq-0073-00_potential-004.acb/vo_card_cmn_03004_03004-5-uniq-0073-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "I wanna go again with you! Is that okay!? If you say no, I’ll eat you up!",
            "audio": "resources/vo_card_cmn_03004_03004-5-uniq-0073-00_potential-005.acb/vo_card_cmn_03004_03004-5-uniq-0073-00_potential-005.mp3"
        }
    ],
