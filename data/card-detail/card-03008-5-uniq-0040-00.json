    "voicelines": [
        {
            "type": "card_get",
            "text": "You all make me so happy. I'm truly blessed to have you all.",
            "audio": "resources/vo_live_dial_card_03008_03008-5-uniq-0040-00_myself.acb/vo_live_dial_card_03008_03008-5-uniq-0040-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Phew~ I guess this should do it. Oh, welcome! Yeah, come on in, it's fine.\nJust wrapped up some work I was tasked with... Hold up, is that the sun rising?\nWow, I did it again. Looks like I've been focused since last night.\nNah, I'm good! Not even a bit tired. I'm built different, you know!\nSo, if you're in trouble, just call me.\nI'll come right away!",
            "audio": "resources/vo_card_cmn_03008_03008-5-uniq-0040-00_situation.acb/vo_card_cmn_03008_03008-5-uniq-0040-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Wanna get some help?",
            "audio": "resources/vo_live_cmn_card_03008_03008-5-uniq-0040-00_skill-card.acb/vo_live_cmn_card_03008_03008-5-uniq-0040-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "This outfit is cool, right? Huh, cute...? Get some help!",
            "audio": "resources/vo_card_cmn_03008_03008-5-uniq-0040-00_potential-001.acb/vo_card_cmn_03008_03008-5-uniq-0040-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Alright, work's wrapped up! Time to get my game on! Ooh ooh ah ah, ooh ooh!",
            "audio": "resources/vo_card_cmn_03008_03008-5-uniq-0040-00_potential-002.acb/vo_card_cmn_03008_03008-5-uniq-0040-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "That dish looks spicy but delish! What, you're sharing? Thanks a bunch!",
            "audio": "resources/vo_card_cmn_03008_03008-5-uniq-0040-00_potential-003.acb/vo_card_cmn_03008_03008-5-uniq-0040-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "I'm about to brew some tea. Wanna join? Wait a moment, okay?",
            "audio": "resources/vo_card_cmn_03008_03008-5-uniq-0040-00_potential-004.acb/vo_card_cmn_03008_03008-5-uniq-0040-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "If you ever have any troubles, just call me.  I'll come running no matter where I am.",
            "audio": "resources/vo_card_cmn_03008_03008-5-uniq-0040-00_potential-005.acb/vo_card_cmn_03008_03008-5-uniq-0040-00_potential-005.mp3"
        }
    ],
