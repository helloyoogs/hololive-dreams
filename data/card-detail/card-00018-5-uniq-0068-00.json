    "voicelines": [
        {
            "type": "card_get",
            "text": "It’s so hot! But I’m having so much fun!♪ \nLet’s make the most out of this summer!",
            "audio": "resources/vo_live_dial_card_00018_00018-5-uniq-0068-00_myself.acb/vo_live_dial_card_00018_00018-5-uniq-0068-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Everyone, gather! We’re gonna have a battle with a team led by Sakura Miko.\nOur team’s objective is absolute victory! Do not fret and strike the enemy with your water guns!\nIf you got it, yell! Yaaaaay!\nI am shaking with excitement! I want to see Mikochi’s face fill with terror when I take her down with my water gun!\nI want to hear her screams already!\nOh, we're about start! Here we go! Charge! YEAAAAAAH!",
            "audio": "resources/vo_card_cmn_00018_00018-5-uniq-0068-00_situation.acb/vo_card_cmn_00018_00018-5-uniq-0068-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "I am the sparkling summer star, Hoshimachi Suisei!",
            "audio": "resources/vo_live_cmn_card_00018_00018-5-uniq-0068-00_skill-card.acb/vo_live_cmn_card_00018_00018-5-uniq-0068-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "These sunglasses are cool, huh? Don’t you dare stand behind me! Just kidding~☆",
            "audio": "resources/vo_card_cmn_00018_00018-5-uniq-0068-00_potential-001.acb/vo_card_cmn_00018_00018-5-uniq-0068-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "I will not stand back! Tremble before HOSHIMACHI!",
            "audio": "resources/vo_card_cmn_00018_00018-5-uniq-0068-00_potential-002.acb/vo_card_cmn_00018_00018-5-uniq-0068-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Thank you for backing me up! I will not forget this! I will always have your back!☆",
            "audio": "resources/vo_card_cmn_00018_00018-5-uniq-0068-00_potential-003.acb/vo_card_cmn_00018_00018-5-uniq-0068-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "The victory for our team is near! Make Mikochi kneel before us!",
            "audio": "resources/vo_card_cmn_00018_00018-5-uniq-0068-00_potential-004.acb/vo_card_cmn_00018_00018-5-uniq-0068-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Here, a soft drink. You did a great job today. Thank you!☆ Let’s hang out again!",
            "audio": "resources/vo_card_cmn_00018_00018-5-uniq-0068-00_potential-005.acb/vo_card_cmn_00018_00018-5-uniq-0068-00_potential-005.mp3"
        }
    ],
