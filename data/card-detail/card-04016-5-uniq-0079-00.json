    "voicelines": [
        {
            "type": "card_get",
            "text": "If you start to overheat, Fuwawa will go 'puff-puff' to cool you down!",
            "audio": "resources/vo_live_dial_card_04016_04016-5-uniq-0079-00_myself.acb/vo_live_dial_card_04016_04016-5-uniq-0079-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Kick kick kick! Kick those legs! BAU BAU! Ehehe! I love the ocean.\nOh? You like my donut floatie?\nOr is it my swimsuit that caught your eye...?\nEhehe! Lui-nee-senpai chose these donut floaties for FUWAMOCO. She said the patterns reminded her of us!\nSo Moco-chan has the same one, but in a different color.\nHuh? You wanna eat it? No, no! This donut is the only thing keeping me afloat!\nGo take a bite out of Moco-chan's if you must!",
            "audio": "resources/vo_card_cmn_04016_04016-5-uniq-0079-00_situation.acb/vo_card_cmn_04016_04016-5-uniq-0079-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Bring it on, summer sun!!!",
            "audio": "resources/vo_live_cmn_card_04016_04016-5-uniq-0079-00_skill-card.acb/vo_live_cmn_card_04016_04016-5-uniq-0079-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Floating on my donut floatie is so comfy... BAU BAU!",
            "audio": "resources/vo_card_cmn_04016_04016-5-uniq-0079-00_potential-001.acb/vo_card_cmn_04016_04016-5-uniq-0079-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "The tropical flowers are so pretty... Which color do you like best?",
            "audio": "resources/vo_card_cmn_04016_04016-5-uniq-0079-00_potential-002.acb/vo_card_cmn_04016_04016-5-uniq-0079-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Oh no! My donut's floating away! Wow, nice save! You're the donut saver!",
            "audio": "resources/vo_card_cmn_04016_04016-5-uniq-0079-00_potential-003.acb/vo_card_cmn_04016_04016-5-uniq-0079-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Here! Over here! Ehehe! Try and catch me!",
            "audio": "resources/vo_card_cmn_04016_04016-5-uniq-0079-00_potential-004.acb/vo_card_cmn_04016_04016-5-uniq-0079-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Did Fuwawa give you butterflies today? I was just... hoping I did...",
            "audio": "resources/vo_card_cmn_04016_04016-5-uniq-0079-00_potential-005.acb/vo_card_cmn_04016_04016-5-uniq-0079-00_potential-005.mp3"
        }
    ],
