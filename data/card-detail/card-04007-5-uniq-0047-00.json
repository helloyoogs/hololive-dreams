    "voicelines": [
        {
            "type": "card_get",
            "text": "Hope is by your side. Now and forever.",
            "audio": "resources/vo_live_dial_card_04007_04007-5-uniq-0047-00_myself.acb/vo_live_dial_card_04007_04007-5-uniq-0047-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Woow! That's pretty high up! But it's nothing I can't handle!\nHey everyone! Lookie! I'm coming in hot from above~!\nAre you enjoying the show? Let me hear you scream!\nAhaha! Hey, you guys~ I know my legs are super long, but I better not catch you staring~ Ahaha!\nAnd for my next song! Uhh... Whoa~! I'm falling!\nAhahaha... Ehem... Alright, need to lock back in! Let's goooo!",
            "audio": "resources/vo_card_cmn_04007_04007-5-uniq-0047-00_situation.acb/vo_card_cmn_04007_04007-5-uniq-0047-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "IRyS here to fill the world with hopium!",
            "audio": "resources/vo_live_cmn_card_04007_04007-5-uniq-0047-00_skill-card.acb/vo_live_cmn_card_04007_04007-5-uniq-0047-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "I'm IRyS the flower fairy~! Ehehe, just kidding! This outfit totally suits me though, right?",
            "audio": "resources/vo_card_cmn_04007_04007-5-uniq-0047-00_potential-001.acb/vo_card_cmn_04007_04007-5-uniq-0047-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "For my next song, hmm... Do you want my angelic or demonic side? Fufufu~",
            "audio": "resources/vo_card_cmn_04007_04007-5-uniq-0047-00_potential-002.acb/vo_card_cmn_04007_04007-5-uniq-0047-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Wow, what a workout! I'm so sweaty!",
            "audio": "resources/vo_card_cmn_04007_04007-5-uniq-0047-00_potential-003.acb/vo_card_cmn_04007_04007-5-uniq-0047-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Time for the finale~ Let's go! Make sure you stick with me to the end, okay?",
            "audio": "resources/vo_card_cmn_04007_04007-5-uniq-0047-00_potential-004.acb/vo_card_cmn_04007_04007-5-uniq-0047-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Yaaaay! That was so much fun! Thank you, so much guys! Daisuki~!",
            "audio": "resources/vo_card_cmn_04007_04007-5-uniq-0047-00_potential-005.acb/vo_card_cmn_04007_04007-5-uniq-0047-00_potential-005.mp3"
        }
