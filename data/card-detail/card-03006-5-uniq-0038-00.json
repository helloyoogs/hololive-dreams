    "voicelines": [
        {
            "type": "card_get",
            "text": "As a token of my appreciation, \nhere's a magical tune to make you smile!",
            "audio": "resources/vo_live_dial_card_03006_03006-5-uniq-0038-00_myself.acb/vo_live_dial_card_03006_03006-5-uniq-0038-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Ooh, the dance floor is so lively. Don't you want to join everyone? ♪\nAh, I see. You're more of a chill and enjoy type, huh?\nMe? Well, I... just might be the type who wants to keep chatting with you like this.\nHuh? You're blushing too much! Ahahaha, you're so funny!\n...Oh, your glass is empty. What would you like next? I'll make it for you ♡\nNow, don't be shy. It's my pleasure.\nIn return, I won't let you go until you've told me lots of stories ♪",
            "audio": "resources/vo_card_cmn_03006_03006-5-uniq-0038-00_situation.acb/vo_card_cmn_03006_03006-5-uniq-0038-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Prepare to be charmed by my elegance ♪",
            "audio": "resources/vo_live_cmn_card_03006_03006-5-uniq-0038-00_skill-card.acb/vo_live_cmn_card_03006_03006-5-uniq-0038-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Feast your eyes on my elegant and glamorous self, okay? ♪",
            "audio": "resources/vo_card_cmn_03006_03006-5-uniq-0038-00_potential-001.acb/vo_card_cmn_03006_03006-5-uniq-0038-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Hey, where are you looking? Give me your full attention, won't you?",
            "audio": "resources/vo_card_cmn_03006_03006-5-uniq-0038-00_potential-002.acb/vo_card_cmn_03006_03006-5-uniq-0038-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Hehe ♪ Hosting this party was worth the effort, everyone's having a blast!",
            "audio": "resources/vo_card_cmn_03006_03006-5-uniq-0038-00_potential-003.acb/vo_card_cmn_03006_03006-5-uniq-0038-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Should you feel a bit drowsy... my shoulder is at your disposal, you know?",
            "audio": "resources/vo_card_cmn_03006_03006-5-uniq-0038-00_potential-004.acb/vo_card_cmn_03006_03006-5-uniq-0038-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "I might just throw another party~. You'll come and see me again, right?",
            "audio": "resources/vo_card_cmn_03006_03006-5-uniq-0038-00_potential-005.acb/vo_card_cmn_03006_03006-5-uniq-0038-00_potential-005.mp3"
        }
    ],
