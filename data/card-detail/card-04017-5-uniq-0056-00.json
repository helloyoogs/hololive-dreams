    "voicelines": [
        {
            "type": "card_get",
            "text": "I'll protect your smile Ready? BAU BAU!",
            "audio": "resources/vo_live_dial_card_04017_04017-5-uniq-0056-00_myself.acb/vo_live_dial_card_04017_04017-5-uniq-0056-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "BAU BAU! Welcome to FUWAMOCO's tea party! We've been waiting for you!\nWe've prepared lots of donuts, so help yourself, okay? Bone apple tea!\nNom.... It's so good and melts right in my mouth!\nHuh? You still can't make up your mind? Oh, well...\nThen, we'll choose for you, okay? But remember, you have to finish every last crumb, or else! \nI'm keeping a watchful eye on you, okay? BAU BAU~!",
            "audio": "resources/vo_card_cmn_04017_04017-5-uniq-0056-00_situation.acb/vo_card_cmn_04017_04017-5-uniq-0056-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "What about Mococo?",
            "audio": "resources/vo_live_cmn_card_04017_04017-5-uniq-0056-00_skill-card.acb/vo_live_cmn_card_04017_04017-5-uniq-0056-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Isn't this outfit super cute? It's all soft and fluffy, I love it!",
            "audio": "resources/vo_card_cmn_04017_04017-5-uniq-0056-00_potential-001.acb/vo_card_cmn_04017_04017-5-uniq-0056-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "I can't decide which donut to eat next... Hmm... hm... It's so hard to choose!",
            "audio": "resources/vo_card_cmn_04017_04017-5-uniq-0056-00_potential-002.acb/vo_card_cmn_04017_04017-5-uniq-0056-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "What? You picked out a donut just for me? Thank you! I'll savor every bite!",
            "audio": "resources/vo_card_cmn_04017_04017-5-uniq-0056-00_potential-003.acb/vo_card_cmn_04017_04017-5-uniq-0056-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "I can see you through the donut hole! Lookie! Ehehe♪",
            "audio": "resources/vo_card_cmn_04017_04017-5-uniq-0056-00_potential-004.acb/vo_card_cmn_04017_04017-5-uniq-0056-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "I'm getting sleepy... Hey, can I lean on your shoulder? ...Ehehe, it's so warm, BAU BAU",
            "audio": "resources/vo_card_cmn_04017_04017-5-uniq-0056-00_potential-005.acb/vo_card_cmn_04017_04017-5-uniq-0056-00_potential-005.mp3"
        }
    ],
