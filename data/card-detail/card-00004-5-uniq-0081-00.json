    "voicelines": [
        {
            "type": "card_get",
            "text": "How to add a splash of color to summer you say? Leave it to me.♪",
            "audio": "resources/vo_live_dial_card_00004_00004-5-uniq-0081-00_myself.acb/vo_live_dial_card_00004_00004-5-uniq-0081-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Did you know? I opened a beach hut the other day!\nHouston, do you read me?\nGeez! I get that swaying in the hammock is the best ever, but it's not nice to half-listen when a girl's talking!\nYa sure about your attitude here? I mean, right now, you could have sexy Aki-chan all to yourself...\nWho knows if you'll get a chance like this ever again... Isn't it a waste to just fall asleep?\nPfft, ahaha! Just kidding~♪ I teased you because I wanted a bit of attention. My bad!\nSo...shall we continue our little private chat?",
            "audio": "resources/vo_card_cmn_00004_00004-5-uniq-0081-00_situation.acb/vo_card_cmn_00004_00004-5-uniq-0081-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Nope. Nobody's sleeping on my watch!",
            "audio": "resources/vo_live_cmn_card_00004_00004-5-uniq-0081-00_skill-card.acb/vo_live_cmn_card_00004_00004-5-uniq-0081-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Have a taste of my swimsuit aura~♪ Mwah~♡ ...Oh wait, was that a bit too intense for you?",
            "audio": "resources/vo_card_cmn_00004_00004-5-uniq-0081-00_potential-001.acb/vo_card_cmn_00004_00004-5-uniq-0081-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Both of these drinks are MINE!♪ Heehee~♪ Just kidding, here's your share!",
            "audio": "resources/vo_card_cmn_00004_00004-5-uniq-0081-00_potential-002.acb/vo_card_cmn_00004_00004-5-uniq-0081-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Ya know, I was dozing off a bit earlier too~♪ But, keep it a secret between us, okay?",
            "audio": "resources/vo_card_cmn_00004_00004-5-uniq-0081-00_potential-003.acb/vo_card_cmn_00004_00004-5-uniq-0081-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Wanna go down to the shoreline? Sure, big sis here will go with you.",
            "audio": "resources/vo_card_cmn_00004_00004-5-uniq-0081-00_potential-004.acb/vo_card_cmn_00004_00004-5-uniq-0081-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Talk about relaxation maxxing~♪ Let's come back here again for some spiritual healing sessions. Of course, together with me!",
            "audio": "resources/vo_card_cmn_00004_00004-5-uniq-0081-00_potential-005.acb/vo_card_cmn_00004_00004-5-uniq-0081-00_potential-005.mp3"
        }
    ],
