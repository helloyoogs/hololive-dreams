    "voicelines": [
        {
            "type": "card_get",
            "text": "Keep on cheering for me until my name\nresounds throughout the universe!\nUntil then, ride on, purple road!",
            "audio": "resources/vo_live_dial_card_06005_06005-5-uniq-0061-00_myself.acb/vo_live_dial_card_06005_06005-5-uniq-0061-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Who ish it? Ooh, we have a newbie.\nI'm Todoroki Hajime! The number one badass in the universe!\nYo! S'good to meetcha!\nAsh a token of our budding friendship... Here. Go on, give it a try.\nIt's shweet, and it'll knock yer shocks off! Nyahahaha!\nWell? Dyu like me? I'm cool, yeah? You shee how badass I really am?\nHey, don't just shtand there. Come sit wiv me and eat candy.",
            "audio": "resources/vo_card_cmn_06005_06005-5-uniq-0061-00_situation.acb/vo_card_cmn_06005_06005-5-uniq-0061-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "I am the purple lightning bolt!",
            "audio": "resources/vo_live_cmn_card_06005_06005-5-uniq-0061-00_skill-card.acb/vo_live_cmn_card_06005_06005-5-uniq-0061-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "I am not a bayby! I am a BADASS! Ishn't it obvious?",
            "audio": "resources/vo_card_cmn_06005_06005-5-uniq-0061-00_potential-001.acb/vo_card_cmn_06005_06005-5-uniq-0061-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Heehee! I think thish hat ish gonna make me even more badass!",
            "audio": "resources/vo_card_cmn_06005_06005-5-uniq-0061-00_potential-002.acb/vo_card_cmn_06005_06005-5-uniq-0061-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Eh? You like my shmile? Nyahaha! You shilly!",
            "audio": "resources/vo_card_cmn_06005_06005-5-uniq-0061-00_potential-003.acb/vo_card_cmn_06005_06005-5-uniq-0061-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "I'm free all day today. So letsh play, play, plaaay!",
            "audio": "resources/vo_card_cmn_06005_06005-5-uniq-0061-00_potential-004.acb/vo_card_cmn_06005_06005-5-uniq-0061-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "I like playing wiv you! I like getting to experience the prime of our youthsh together!",
            "audio": "resources/vo_card_cmn_06005_06005-5-uniq-0061-00_potential-005.acb/vo_card_cmn_06005_06005-5-uniq-0061-00_potential-005.mp3"
        }
