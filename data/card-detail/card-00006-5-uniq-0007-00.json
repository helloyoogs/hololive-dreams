    "voicelines": [
        {
            "type": "card_get",
            "text": "We're all here today all thanks to you.\nLet's keep shooting for the stars!",
            "audio": "resources/vo_live_dial_card_00006_00006-5-uniq-0007-00_myself.acb/vo_live_dial_card_00006_00006-5-uniq-0007-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "What's this? A wayward soul wandering in sacred grounds?\nHeh heh... You look like you'd go down in one gulp...\nPft... PAHAHAHA!!! No, no, I kid! I'm not a fox spirit, I'm just Fubuki!\nHeh, you should have seen your face... This fox mask really paid off, haha!\nCome on, let's get going to the festival. There's so much I wanna do!\nI wanna eat the candied apples, the takoyaki, the taiyaki, the fried chicken... You know what? Let's just visit all the stalls!\nWe're gonna have all the fun today! Woohoo!",
            "audio": "resources/vo_card_cmn_00006_00006-5-uniq-0007-00_situation.acb/vo_card_cmn_00006_00006-5-uniq-0007-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Too much shine? Guess I'm just RADIANT!",
            "audio": "resources/vo_live_cmn_card_00006_00006-5-uniq-0007-00_skill-card.acb/vo_live_cmn_card_00006_00006-5-uniq-0007-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "What a gorgeous kimono! And it's even got my favorite flowers on it.",
            "audio": "resources/vo_card_cmn_00006_00006-5-uniq-0007-00_potential-001.acb/vo_card_cmn_00006_00006-5-uniq-0007-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Yummy yummy takoyaki! Oh? Nope! Look at me with those puppy dog eyes all you want, but you're not having any!",
            "audio": "resources/vo_card_cmn_00006_00006-5-uniq-0007-00_potential-002.acb/vo_card_cmn_00006_00006-5-uniq-0007-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Ugh, it's so hot... Shall we make a stop by that shaved ice vendor?",
            "audio": "resources/vo_card_cmn_00006_00006-5-uniq-0007-00_potential-003.acb/vo_card_cmn_00006_00006-5-uniq-0007-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Oh, you wanna see who shoots better? Heh heh heh... Challenge accepted!",
            "audio": "resources/vo_card_cmn_00006_00006-5-uniq-0007-00_potential-004.acb/vo_card_cmn_00006_00006-5-uniq-0007-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Thanks for coming to the festival with me today! Oh man, it was so much fun! Let's...do this again, yeah?",
            "audio": "resources/vo_card_cmn_00006_00006-5-uniq-0007-00_potential-005.acb/vo_card_cmn_00006_00006-5-uniq-0007-00_potential-005.mp3"
        }
    ],
