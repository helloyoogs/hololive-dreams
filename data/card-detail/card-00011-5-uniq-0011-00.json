    "voicelines": [
        {
            "type": "card_get",
            "text": "I'm only here thanks to you guys! \nHere's to many more years together!",
            "audio": "resources/vo_live_dial_card_00011_00011-5-uniq-0011-00_myself.acb/vo_live_dial_card_00011_00011-5-uniq-0011-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Jeez, you’re such a needy one ♪ You really wanted to sleep together that badly? ♪\nSure thing♪ I will pamper you a whole lot♪ *headpats*\nHaha, you look so happy! Did you want headpats that badly?\nAren’t you nodding a bit too much? Your eyes are really sparkling too.\nOh my, you’re way too honest with what you want.\nAlright, that’s it for today! But we’ll continue…another time, okay? ♪",
            "audio": "resources/vo_card_cmn_00011_00011-5-uniq-0011-00_situation.acb/vo_card_cmn_00011_00011-5-uniq-0011-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Aah! That’s sweet!",
            "audio": "resources/vo_live_cmn_card_00011_00011-5-uniq-0011-00_skill-card.acb/vo_live_cmn_card_00011_00011-5-uniq-0011-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "A new outfit really gets me hyped ♪ I’m heading out to play!",
            "audio": "resources/vo_card_cmn_00011_00011-5-uniq-0011-00_potential-001.acb/vo_card_cmn_00011_00011-5-uniq-0011-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Maybe this sexy devil will go ahead and corrupt everyone for funsies~♪",
            "audio": "resources/vo_card_cmn_00011_00011-5-uniq-0011-00_potential-002.acb/vo_card_cmn_00011_00011-5-uniq-0011-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Morning... Just a bit more... G’nite...",
            "audio": "resources/vo_card_cmn_00011_00011-5-uniq-0011-00_potential-003.acb/vo_card_cmn_00011_00011-5-uniq-0011-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Satisfy my curiosity… What have you been looking at this whole time? ♪",
            "audio": "resources/vo_card_cmn_00011_00011-5-uniq-0011-00_potential-004.acb/vo_card_cmn_00011_00011-5-uniq-0011-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Thanks for always waking me up... I really appreciate it…♪",
            "audio": "resources/vo_card_cmn_00011_00011-5-uniq-0011-00_potential-005.acb/vo_card_cmn_00011_00011-5-uniq-0011-00_potential-005.mp3"
        }
    ],
