    "voicelines": [
        {
            "type": "card_get",
            "text": "Thank you for falling in love with me!",
            "audio": "resources/vo_live_dial_card_00004_00004-5-uniq-0005-00_myself.acb/vo_live_dial_card_00004_00004-5-uniq-0005-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Oh? I wasn't expecting a visitor this deep in the woods... Or maybe...you're lost?\nYou'd better watch out, or the big bad half-elf is gonna get you! Ahaha, just kidding!\nAhaha, sorry. Don't mind me. And come on, don't just stand there. Wanna go for a quick dip?\nThe water's nice and refreshing! Huh? No, don't be embarrassed. What's there to be embarrassed about?\nCome on... Let me wash those nerves away!",
            "audio": "resources/vo_card_cmn_00004_00004-5-uniq-0005-00_situation.acb/vo_card_cmn_00004_00004-5-uniq-0005-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "This is the path we walk!",
            "audio": "resources/vo_live_cmn_card_00004_00004-5-uniq-0005-00_skill-card.acb/vo_live_cmn_card_00004_00004-5-uniq-0005-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Wanna see my moves? I can perform your very own little forest musical.",
            "audio": "resources/vo_card_cmn_00004_00004-5-uniq-0005-00_potential-001.acb/vo_card_cmn_00004_00004-5-uniq-0005-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Hey... Were you fawning over the back of me just now?",
            "audio": "resources/vo_card_cmn_00004_00004-5-uniq-0005-00_potential-002.acb/vo_card_cmn_00004_00004-5-uniq-0005-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Phew! All that dancing has got me pooped! I'd say it's time for drinks now. Who's game?",
            "audio": "resources/vo_card_cmn_00004_00004-5-uniq-0005-00_potential-003.acb/vo_card_cmn_00004_00004-5-uniq-0005-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "I just...feel better with you around. Won't you stay with me...a little while longer?",
            "audio": "resources/vo_card_cmn_00004_00004-5-uniq-0005-00_potential-004.acb/vo_card_cmn_00004_00004-5-uniq-0005-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Are you sleepy? Don't worry, you can rest your head in my lap. Here, it's ready for you, hehe!",
            "audio": "resources/vo_card_cmn_00004_00004-5-uniq-0005-00_potential-005.acb/vo_card_cmn_00004_00004-5-uniq-0005-00_potential-005.mp3"
        }
    ],
