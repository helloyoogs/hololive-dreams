    "voicelines": [
        {
            "type": "card_get",
            "text": "I'll be protecting your smile. BAU BAU!",
            "audio": "resources/vo_live_dial_card_04016_04016-5-uniq-0055-00_myself.acb/vo_live_dial_card_04016_04016-5-uniq-0055-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "BAU BAU! Welcome to FUWAMOCO's tea party!\nI'm so happy you came! Please, have a seat~\nHehe, don't be shy! Help yourself to some donuts~ Take whichever you like.\n...By the way, these donuts here were prepared by me, and those over there were prepared by Moco-chan~!\nThey're all super sweet and absolutely delicious, I promise you~\nTeehee, which donut will you choose?\nPlease pick one, BAU BAU!",
            "audio": "resources/vo_card_cmn_04016_04016-5-uniq-0055-00_situation.acb/vo_card_cmn_04016_04016-5-uniq-0055-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "It's time to BAU BAU!",
            "audio": "resources/vo_live_cmn_card_04016_04016-5-uniq-0055-00_skill-card.acb/vo_live_cmn_card_04016_04016-5-uniq-0055-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "This outfit is so cute, right? So soft and fluffy, I love it.",
            "audio": "resources/vo_card_cmn_04016_04016-5-uniq-0055-00_potential-001.acb/vo_card_cmn_04016_04016-5-uniq-0055-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Waaah... This donut is so yummy~ I'm so happy, BAU BAU!",
            "audio": "resources/vo_card_cmn_04016_04016-5-uniq-0055-00_potential-002.acb/vo_card_cmn_04016_04016-5-uniq-0055-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "That donut looks delicious too... Eh, I can have it?! Yay♪",
            "audio": "resources/vo_card_cmn_04016_04016-5-uniq-0055-00_potential-003.acb/vo_card_cmn_04016_04016-5-uniq-0055-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Ehehee, you got some cream on your cheek~ Let me wipe it off for you.",
            "audio": "resources/vo_card_cmn_04016_04016-5-uniq-0055-00_potential-004.acb/vo_card_cmn_04016_04016-5-uniq-0055-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "I had such a lovely time together. It's so comfy and warm here with you. So, make sure to come back soon! Okay? BAU BAU!",
            "audio": "resources/vo_card_cmn_04016_04016-5-uniq-0055-00_potential-005.acb/vo_card_cmn_04016_04016-5-uniq-0055-00_potential-005.mp3"
        }
    ],
