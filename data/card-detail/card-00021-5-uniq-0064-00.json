    "voicelines": [
        {
            "type": "card_get",
            "text": "Don’t let the heat beat you! I will give you all my energy!",
            "audio": "resources/vo_live_dial_card_00021_00021-5-uniq-0064-00_myself.acb/vo_live_dial_card_00021_00021-5-uniq-0064-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "The sun has gone down. I guess it's time for that thing. Ta-da! Fireworks!\nI wanted to do them last time we came to the beach. Here, there are many so you can pick any.\nI will have this one and this one. Let’s light them together! One, two...\nOh, look! It is so pretty!\nBehold! A double firework wielder! Just kidding!\nOh, that one is the color-changing type. That's nice... Let me hold it for a bit.",
            "audio": "resources/vo_card_cmn_00021_00021-5-uniq-0064-00_situation.acb/vo_card_cmn_00021_00021-5-uniq-0064-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Let's get even more fired up!",
            "audio": "resources/vo_live_cmn_card_00021_00021-5-uniq-0064-00_skill-card.acb/vo_live_cmn_card_00021_00021-5-uniq-0064-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "I decided to place some sunflowers around since it's summer. Nice, huh?",
            "audio": "resources/vo_card_cmn_00021_00021-5-uniq-0064-00_potential-001.acb/vo_card_cmn_00021_00021-5-uniq-0064-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "I am right here! Try and catch me! Ahaha~♪ You ended up falling down! Are you alright?",
            "audio": "resources/vo_card_cmn_00021_00021-5-uniq-0064-00_potential-002.acb/vo_card_cmn_00021_00021-5-uniq-0064-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "I just found some pretty shells! Since I found two, I’ll give you one!",
            "audio": "resources/vo_card_cmn_00021_00021-5-uniq-0064-00_potential-003.acb/vo_card_cmn_00021_00021-5-uniq-0064-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "The sparklers are the best to finish. Whoever drops it first has to pay for ice creams afterwards.",
            "audio": "resources/vo_card_cmn_00021_00021-5-uniq-0064-00_potential-004.acb/vo_card_cmn_00021_00021-5-uniq-0064-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "That was really moving, hehe. Thank you, it’s become a lovely summer memory.",
            "audio": "resources/vo_card_cmn_00021_00021-5-uniq-0064-00_potential-005.acb/vo_card_cmn_00021_00021-5-uniq-0064-00_potential-005.mp3"
        }
    ],
