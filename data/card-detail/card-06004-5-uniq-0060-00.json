    "voicelines": [
        {
            "type": "card_get",
            "text": "Thank you, everyone! \nI hope to continue our great relations together!",
            "audio": "resources/vo_live_dial_card_06004_06004-5-uniq-0060-00_myself.acb/vo_live_dial_card_06004_06004-5-uniq-0060-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "We’ve arrived! I really wanted to check this exhibition!!\nLook at this magnificient piece! It’s the highlight of this exhibition!\nHow is it? Oh, I see I see! That’s a different impression not even I would dare to think about!\nNo, no, you’re totally right! Any impression you have is the correct one!\nThere are as many ways to interpret art as there are people. Just enjoy it however your heart feels! Let’s dive deeper into this world!",
            "audio": "resources/vo_card_cmn_06004_06004-5-uniq-0060-00_situation.acb/vo_card_cmn_06004_06004-5-uniq-0060-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Just as expected, shime-shimeji!",
            "audio": "resources/vo_live_cmn_card_06004_06004-5-uniq-0060-00_skill-card.acb/vo_live_cmn_card_06004_06004-5-uniq-0060-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "This is Juufuutei Raden’s new look! Please continue to support me from now on!",
            "audio": "resources/vo_card_cmn_06004_06004-5-uniq-0060-00_potential-001.acb/vo_card_cmn_06004_06004-5-uniq-0060-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Shhh! Be quiet in the museum... OH I WANTED TO SEE THAT ONE SO MUCH!",
            "audio": "resources/vo_card_cmn_06004_06004-5-uniq-0060-00_potential-002.acb/vo_card_cmn_06004_06004-5-uniq-0060-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Wow, a workshop! Do you think I can drop by?",
            "audio": "resources/vo_card_cmn_06004_06004-5-uniq-0060-00_potential-003.acb/vo_card_cmn_06004_06004-5-uniq-0060-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "If you visit a museum, it is imperative to check out the souvenir shop! It’s this way, hurry!",
            "audio": "resources/vo_card_cmn_06004_06004-5-uniq-0060-00_potential-004.acb/vo_card_cmn_06004_06004-5-uniq-0060-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "I have plenty of other museums I like too~ ♪ If you want, let’s go together again sometime!",
            "audio": "resources/vo_card_cmn_06004_06004-5-uniq-0060-00_potential-005.acb/vo_card_cmn_06004_06004-5-uniq-0060-00_potential-005.mp3"
        }
    ],
