    "voicelines": [
        {
            "type": "card_get",
            "text": "You guys made me the idol I am today! \nLet's make tomorrow sparkle even more!",
            "audio": "resources/vo_live_dial_card_00012_00012-5-uniq-0012-00_myself.acb/vo_live_dial_card_00012_00012-5-uniq-0012-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "So cold~ Hey you guys, quit flapping your wings already!\nJeez, my clothes got wet. But hey, with a weather this nice, they’ll dry in no time ♪\nWhat are you doing over there!? Come over here and hang out with us!\nAh, wait! We’ll come over there! Alright everyone, gather up!\nStop quacking and making a fuss, alright? From here, we’re going to race to over there!\nHere we go! Three, two… Go, go, go! Hahaha!",
            "audio": "resources/vo_card_cmn_00012_00012-5-uniq-0012-00_situation.acb/vo_card_cmn_00012_00012-5-uniq-0012-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Don't pick on meee!",
            "audio": "resources/vo_live_cmn_card_00012_00012-5-uniq-0012-00_skill-card.acb/vo_live_cmn_card_00012_00012-5-uniq-0012-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Oversized clothes are definitely the way to go! What do you think? Isn’t it cute?",
            "audio": "resources/vo_card_cmn_00012_00012-5-uniq-0012-00_potential-001.acb/vo_card_cmn_00012_00012-5-uniq-0012-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "See this patch? It’s Subaru’s favorite!",
            "audio": "resources/vo_card_cmn_00012_00012-5-uniq-0012-00_potential-002.acb/vo_card_cmn_00012_00012-5-uniq-0012-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "I found a really great song! Here—headphones! Give it a go!",
            "audio": "resources/vo_card_cmn_00012_00012-5-uniq-0012-00_potential-003.acb/vo_card_cmn_00012_00012-5-uniq-0012-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "This hat is pretty cool, right? Wanna go buy a matching set together? ♪",
            "audio": "resources/vo_card_cmn_00012_00012-5-uniq-0012-00_potential-004.acb/vo_card_cmn_00012_00012-5-uniq-0012-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Hiya! Are you free right now? Wanna go hang out!? I’ll go wherever you want!",
            "audio": "resources/vo_card_cmn_00012_00012-5-uniq-0012-00_potential-005.acb/vo_card_cmn_00012_00012-5-uniq-0012-00_potential-005.mp3"
        }
    ],
