    "voicelines": [
        {
            "type": "card_get",
            "text": "With you all by my side, I feel like the sky's the limit!",
            "audio": "resources/vo_live_dial_card_00013_00013-5-uniq-0002-00_myself.acb/vo_live_dial_card_00013_00013-5-uniq-0002-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Are you having fun, everyone~?!\nSinging surrounded by petals... What a great atmosphere!\nAnd being surrounded by so many cheers like this… AZKi is truly happy ♪\nDon’t forget to stay hydrated, ‘cause we are headed into the second half of the concert!\nIf you get tired, make sure to take a proper break, okay? It’s a promise with AZKi!\nThis is my next song!\nI’ll sing with all my heart so it reaches everyone!",
            "audio": "resources/vo_card_cmn_00013_00013-5-uniq-0002-00_situation.acb/vo_card_cmn_00013_00013-5-uniq-0002-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "ZeroGuessr!",
            "audio": "resources/vo_live_cmn_card_00013_00013-5-uniq-0002-00_skill-card.acb/vo_live_cmn_card_00013_00013-5-uniq-0002-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "I’ve started flower arrangement... What do you think of it?",
            "audio": "resources/vo_card_cmn_00013_00013-5-uniq-0002-00_potential-001.acb/vo_card_cmn_00013_00013-5-uniq-0002-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Pffft! I’ve found plenty of smiles! ♪",
            "audio": "resources/vo_card_cmn_00013_00013-5-uniq-0002-00_potential-002.acb/vo_card_cmn_00013_00013-5-uniq-0002-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "I’ll sing with all my heart, so please, don’t take your eyes off AZKi!",
            "audio": "resources/vo_card_cmn_00013_00013-5-uniq-0002-00_potential-003.acb/vo_card_cmn_00013_00013-5-uniq-0002-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "The concert isn’t over until you get home! Make sure to take lots of memories of AZKi with you!",
            "audio": "resources/vo_card_cmn_00013_00013-5-uniq-0002-00_potential-004.acb/vo_card_cmn_00013_00013-5-uniq-0002-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Thank you so much for always supporting me! Let’s keep making a beautiful world together ♪",
            "audio": "resources/vo_card_cmn_00013_00013-5-uniq-0002-00_potential-005.acb/vo_card_cmn_00013_00013-5-uniq-0002-00_potential-005.mp3"
        }
    ],
