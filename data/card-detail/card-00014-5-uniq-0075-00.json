    "voicelines": [
        {
            "type": "card_get",
            "text": "Summer memories are precious. There’s no better way than making them together!",
            "audio": "resources/vo_live_dial_card_00014_00014-5-uniq-0075-00_myself.acb/vo_live_dial_card_00014_00014-5-uniq-0075-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "The heat’s really gotten to you, huh~\nMe? I’m totally fine, actually. Maybe I got used to the heat living on THAT island?\nHey, you’d better worry about yourself!\nIf you keep making that face, I’ll stop fanning you!\nAww... To be honest, I would still be worried, so I won’t stop.\nHow’s this? Are you feeling better?\nOhh, that’s good to hear~♪ Once we rest a little bit more, let’s go play again, okay?♪",
            "audio": "resources/vo_card_cmn_00014_00014-5-uniq-0075-00_situation.acb/vo_card_cmn_00014_00014-5-uniq-0075-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Summer’s hereeeee!",
            "audio": "resources/vo_live_cmn_card_00014_00014-5-uniq-0075-00_skill-card.acb/vo_live_cmn_card_00014_00014-5-uniq-0075-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "S-So, how’s this? A black and red swimsuit! I thought it was kinda like me. You think it’s cute? Ehehe.",
            "audio": "resources/vo_card_cmn_00014_00014-5-uniq-0075-00_potential-001.acb/vo_card_cmn_00014_00014-5-uniq-0075-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "They said that if you walk that way for a bit, there’s a rocky area! Wanna go find some rare stones?",
            "audio": "resources/vo_card_cmn_00014_00014-5-uniq-0075-00_potential-002.acb/vo_card_cmn_00014_00014-5-uniq-0075-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "W-waah~! I feel like the waves are gonna make me slip! Ah... wait! Let’s go in slowly, okay? Nice and slow...",
            "audio": "resources/vo_card_cmn_00014_00014-5-uniq-0075-00_potential-003.acb/vo_card_cmn_00014_00014-5-uniq-0075-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "You’re starting to get hungry, right? No worries! I’ve prepared lunch! Wanna eat together~?",
            "audio": "resources/vo_card_cmn_00014_00014-5-uniq-0075-00_potential-004.acb/vo_card_cmn_00014_00014-5-uniq-0075-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Did you make any special summer memories? I-I think I might’ve made one today~♪",
            "audio": "resources/vo_card_cmn_00014_00014-5-uniq-0075-00_potential-005.acb/vo_card_cmn_00014_00014-5-uniq-0075-00_potential-005.mp3"
        }
    ],
