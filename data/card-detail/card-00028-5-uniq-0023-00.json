    "voicelines": [
        {
            "type": "card_get",
            "text": "Will you please stay by my side forever and ever?",
            "audio": "resources/vo_live_dial_card_00028_00028-5-uniq-0023-00_myself.acb/vo_live_dial_card_00028_00028-5-uniq-0023-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Are you still not ready? I’m tired of waiting already...\n...Hm? You want me to help too? But weren’t you guys the ones to say let's have a party?\nThen you guys should be treating me like a guest!\nPlus with all of you there, it’ll be a beautiful party! See, Nnatan doesn’t have a single thing to do!\nNow you understand that, do your best, everyone! Quickly now!",
            "audio": "resources/vo_card_cmn_00028_00028-5-uniq-0023-00_situation.acb/vo_card_cmn_00028_00028-5-uniq-0023-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Nnananana!",
            "audio": "resources/vo_live_cmn_card_00028_00028-5-uniq-0023-00_skill-card.acb/vo_live_cmn_card_00028_00028-5-uniq-0023-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "When you think of Nnatan, you think pink, right? Suits me, right?",
            "audio": "resources/vo_card_cmn_00028_00028-5-uniq-0023-00_potential-001.acb/vo_card_cmn_00028_00028-5-uniq-0023-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "A girl this cute should be complimented more. Tch...",
            "audio": "resources/vo_card_cmn_00028_00028-5-uniq-0023-00_potential-002.acb/vo_card_cmn_00028_00028-5-uniq-0023-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Wanna take a picture with me? Say cheese...!",
            "audio": "resources/vo_card_cmn_00028_00028-5-uniq-0023-00_potential-003.acb/vo_card_cmn_00028_00028-5-uniq-0023-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Are you glad to be coming to a party with me? Hehehe.",
            "audio": "resources/vo_card_cmn_00028_00028-5-uniq-0023-00_potential-004.acb/vo_card_cmn_00028_00028-5-uniq-0023-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "This is the kind of party I like. Keep on serving me like this!",
            "audio": "resources/vo_card_cmn_00028_00028-5-uniq-0023-00_potential-005.acb/vo_card_cmn_00028_00028-5-uniq-0023-00_potential-005.mp3"
        }
    ],
