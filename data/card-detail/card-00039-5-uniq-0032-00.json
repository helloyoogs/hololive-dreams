    "voicelines": [
        {
            "type": "card_get",
            "text": "I won't stop trying. \nI'll keep doing my best every step of the way!",
            "audio": "resources/vo_live_dial_card_00039_00039-5-uniq-0032-00_myself.acb/vo_live_dial_card_00039_00039-5-uniq-0032-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Great job on the training! How about taking a little break? Here, have some water.\nThe way of the sword isn’t mastered in a day, there’s no need to rush.\nThis was my impression of a master talking to a student. Cool, right?\nI am very tsuyoi and cool, after all! Wait, what’s with that sad look on your face?\nAnything you wanna say!? Huh? That I split the watter bottle in half?\nAHHHHH! I’m sorry!!!",
            "audio": "resources/vo_card_cmn_00039_00039-5-uniq-0032-00_situation.acb/vo_card_cmn_00039_00039-5-uniq-0032-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Hard work, don't fail me now!",
            "audio": "resources/vo_live_cmn_card_00039_00039-5-uniq-0032-00_skill-card.acb/vo_live_cmn_card_00039_00039-5-uniq-0032-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "My feet feel so light and free, it’s way easier to move than it looks!",
            "audio": "resources/vo_card_cmn_00039_00039-5-uniq-0032-00_potential-001.acb/vo_card_cmn_00039_00039-5-uniq-0032-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "I’ll draw my sword out and strike a pose! I did look cool, right? ♪",
            "audio": "resources/vo_card_cmn_00039_00039-5-uniq-0032-00_potential-002.acb/vo_card_cmn_00039_00039-5-uniq-0032-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "More cool than I think, you say? Hehehe, thanks gozaru! ♪",
            "audio": "resources/vo_card_cmn_00039_00039-5-uniq-0032-00_potential-003.acb/vo_card_cmn_00039_00039-5-uniq-0032-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Huh, huh? B-But please, do not praise me too much! It’s embarrassing... PLEASE STAHP!",
            "audio": "resources/vo_card_cmn_00039_00039-5-uniq-0032-00_potential-004.acb/vo_card_cmn_00039_00039-5-uniq-0032-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Is it okay if I take a little nap…? I leave my back to you...",
            "audio": "resources/vo_card_cmn_00039_00039-5-uniq-0032-00_potential-005.acb/vo_card_cmn_00039_00039-5-uniq-0032-00_potential-005.mp3"
        }
    ],
