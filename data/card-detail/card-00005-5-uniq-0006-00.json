    "voicelines": [
        {
            "type": "card_get",
            "text": "You all make me so happy—\nI want this to last forever!",
            "audio": "resources/vo_live_dial_card_00005_00005-5-uniq-0006-00_myself.acb/vo_live_dial_card_00005_00005-5-uniq-0006-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Haachama-chama♪ Your guard is down! Here goes! Haachama’s special choco attack!\nHere you are. I brought you tons of chocolate☆\nThey are all made by yours truly, so there’s nothing to worry about♪\nHuh? Of course there’s nothing weird mixed in!\nHmmm... Maybe just a lil’ bit? I just poured lots of love, you silly! But I will not tell you the ingredients love is made of♪\nC’mon! Open your mouth!\nSay “ahh” for me♪",
            "audio": "resources/vo_card_cmn_00005_00005-5-uniq-0006-00_situation.acb/vo_card_cmn_00005_00005-5-uniq-0006-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Oh? You want Haachama to step on you?",
            "audio": "resources/vo_live_cmn_card_00005_00005-5-uniq-0006-00_skill-card.acb/vo_live_cmn_card_00005_00005-5-uniq-0006-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "How’s this new look!? Ain’t me the cutest thing around!?",
            "audio": "resources/vo_card_cmn_00005_00005-5-uniq-0006-00_potential-001.acb/vo_card_cmn_00005_00005-5-uniq-0006-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Hmm, it seems you won’t open your mouth no matter what... Don’t make me go all “open sesame” on you!",
            "audio": "resources/vo_card_cmn_00005_00005-5-uniq-0006-00_potential-002.acb/vo_card_cmn_00005_00005-5-uniq-0006-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "See? It’s a totally normal and tasty chocolate, right? You’re really such a worry-wart♪",
            "audio": "resources/vo_card_cmn_00005_00005-5-uniq-0006-00_potential-003.acb/vo_card_cmn_00005_00005-5-uniq-0006-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Since I gave you chocolate, NOW I am supposed to get something in return, okay?♪",
            "audio": "resources/vo_card_cmn_00005_00005-5-uniq-0006-00_potential-004.acb/vo_card_cmn_00005_00005-5-uniq-0006-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "I know what I want! I want YOU to continue eating my cooking...FOREVER! I’ve go you covered!♪",
            "audio": "resources/vo_card_cmn_00005_00005-5-uniq-0006-00_potential-005.acb/vo_card_cmn_00005_00005-5-uniq-0006-00_potential-005.mp3"
        }
    ],
