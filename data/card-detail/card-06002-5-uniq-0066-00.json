    "voicelines": [
        {
            "type": "card_get",
            "text": "We’ll make some noise this summer! \nEveryone, play with me!",
            "audio": "resources/vo_live_dial_card_06002_06002-5-uniq-0066-00_myself.acb/vo_live_dial_card_06002_06002-5-uniq-0066-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Heheheh... Behold... Kanade’s most coolest watergun!\nWe splashed around together last time. But now, with this, you’re all getting soaked head to toe! Gahahahaha!\nWh-Whaaaaat?! A bigger watergun than MINE?!\nThat is playing dirty! I didn't know you had something like THAT!!!\nWell if it comes to that...I’d looove to try out that watergun of yours! Wanna trade?\nOh, you don’t? You’re stingy! You stupid-head!\nOh, you’re angry now? Better make a quick escape!♪",
            "audio": "resources/vo_card_cmn_06002_06002-5-uniq-0066-00_situation.acb/vo_card_cmn_06002_06002-5-uniq-0066-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "It’s summer and Kanade is here! Yaaay!",
            "audio": "resources/vo_live_cmn_card_06002_06002-5-uniq-0066-00_skill-card.acb/vo_live_cmn_card_06002_06002-5-uniq-0066-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "We are at the seaside! Let's play rough all day long!",
            "audio": "resources/vo_card_cmn_06002_06002-5-uniq-0066-00_potential-001.acb/vo_card_cmn_06002_06002-5-uniq-0066-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Gahaha! What do you think? I look so clean-cut in my swimsuit! Ga-hahaha!♪",
            "audio": "resources/vo_card_cmn_06002_06002-5-uniq-0066-00_potential-002.acb/vo_card_cmn_06002_06002-5-uniq-0066-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "You want to buy shaved ice for meee! You want to buy shaved ice for meee! Heheh!",
            "audio": "resources/vo_card_cmn_06002_06002-5-uniq-0066-00_potential-003.acb/vo_card_cmn_06002_06002-5-uniq-0066-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Let’s make a sandcastle together! Come ooon! Pleasee!",
            "audio": "resources/vo_card_cmn_06002_06002-5-uniq-0066-00_potential-004.acb/vo_card_cmn_06002_06002-5-uniq-0066-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Oh, you’re leaving so soon? Well, okay. Let’s come together another time. Promise!",
            "audio": "resources/vo_card_cmn_06002_06002-5-uniq-0066-00_potential-005.acb/vo_card_cmn_06002_06002-5-uniq-0066-00_potential-005.mp3"
        }
    ],
