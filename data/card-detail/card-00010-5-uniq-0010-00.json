    "voicelines": [
        {
            "type": "card_get",
            "text": "I'm gonna do my best so you all know just how grateful I am!",
            "audio": "resources/vo_live_dial_card_00010_00010-5-uniq-0010-00_myself.acb/vo_live_dial_card_00010_00010-5-uniq-0010-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Woah! It’s so pretty and magical!\nTo think such a place existed... I’m so glad we made a little detour!\n*sniff sniff sniff* Something smells really nice~ Ah, the smell came from my flowers all along. Hehe…\nThanks for picking out these flowers for me ♪ I’ll make sure to display them carefully when I get back to my room ♪\nBut before that… Wanna explore around here a bit more? Really? Yay!\nAlright then! Should we start with that path? Or maybe this one? Hmm, decisions decisions... Eeny, meeny, miny, moe, catch a demon by the toe, eeny, meeny, miny, moe ♪",
            "audio": "resources/vo_card_cmn_00010_00010-5-uniq-0010-00_situation.acb/vo_card_cmn_00010_00010-5-uniq-0010-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "That's me again!",
            "audio": "resources/vo_live_cmn_card_00010_00010-5-uniq-0010-00_skill-card.acb/vo_live_cmn_card_00010_00010-5-uniq-0010-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Quiz time! How many butterflies are on this kimono? The answer is…a bunch of them!",
            "audio": "resources/vo_card_cmn_00010_00010-5-uniq-0010-00_potential-001.acb/vo_card_cmn_00010_00010-5-uniq-0010-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Did you like my quizmono? Ahahaha!",
            "audio": "resources/vo_card_cmn_00010_00010-5-uniq-0010-00_potential-002.acb/vo_card_cmn_00010_00010-5-uniq-0010-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Sorry, were you saying something? I didn’t catch any of it.",
            "audio": "resources/vo_card_cmn_00010_00010-5-uniq-0010-00_potential-003.acb/vo_card_cmn_00010_00010-5-uniq-0010-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Urk! A full moon! My demon power is...not awakening anytime soon ♪",
            "audio": "resources/vo_card_cmn_00010_00010-5-uniq-0010-00_potential-004.acb/vo_card_cmn_00010_00010-5-uniq-0010-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Y-Yeah, let’s head home… Um, hey! Will you go out with me again sometime?",
            "audio": "resources/vo_card_cmn_00010_00010-5-uniq-0010-00_potential-005.acb/vo_card_cmn_00010_00010-5-uniq-0010-00_potential-005.mp3"
        }
    ],
