    "voicelines": [
        {
            "type": "card_get",
            "text": "To thank you all, I'll welcome you to Khaos! \nDoncha miss it, mate!",
            "audio": "resources/vo_live_dial_card_04012_04012-5-uniq-0051-00_myself.acb/vo_live_dial_card_04012_04012-5-uniq-0051-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Welcome to Bae's special dance stage!\nThe worldwide rat idol, Baelz Hakos, is gonna give you all an amazing show!\nPrepare to have your jaw hitting the floor by my out-of-this-world dance techniques!\nOh, listen listen! Mr. Squeaks has something to add!\nHe says this dance will make your eyes pop out of your head.\nAlright, it's showtime!\nHere we go... Let's dance!",
            "audio": "resources/vo_card_cmn_04012_04012-5-uniq-0051-00_situation.acb/vo_card_cmn_04012_04012-5-uniq-0051-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "WITNESS MEEE!!!",
            "audio": "resources/vo_live_cmn_card_04012_04012-5-uniq-0051-00_skill-card.acb/vo_live_cmn_card_04012_04012-5-uniq-0051-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "This costume's all about cheese, you know! When you think of rats, it's gotta be cheese, right?",
            "audio": "resources/vo_card_cmn_04012_04012-5-uniq-0051-00_potential-001.acb/vo_card_cmn_04012_04012-5-uniq-0051-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Come on, let's all dance together! If you wanna shake a leg, get up on the stage!",
            "audio": "resources/vo_card_cmn_04012_04012-5-uniq-0051-00_potential-002.acb/vo_card_cmn_04012_04012-5-uniq-0051-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Wow, that beat drop was pretty sick! Those are some serious moves!",
            "audio": "resources/vo_card_cmn_04012_04012-5-uniq-0051-00_potential-003.acb/vo_card_cmn_04012_04012-5-uniq-0051-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "BOO! ...Hehehe, did I give you a fright? Here, have a drink. You were dancing really well!",
            "audio": "resources/vo_card_cmn_04012_04012-5-uniq-0051-00_potential-004.acb/vo_card_cmn_04012_04012-5-uniq-0051-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Why don't we practice dancing together sometime? I've got some killer steps to show you. You in?",
            "audio": "resources/vo_card_cmn_04012_04012-5-uniq-0051-00_potential-005.acb/vo_card_cmn_04012_04012-5-uniq-0051-00_potential-005.mp3"
        }
    ],
