    "voicelines": [
        {
            "type": "card_get",
            "text": "If you're gonna surrender to summer fatigue, \nyour soul's getting reaped! Alright, go all in!",
            "audio": "resources/vo_live_dial_card_04001_04001-5-uniq-0071-00_myself.acb/vo_live_dial_card_04001_04001-5-uniq-0071-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Spiiiike! Woohooo, nailed that!\nThat's the match point. Just one more and victory's mine.\nUh, hey hey? Where'd that confidence go? You're just gonna lose pathetically like this?\n...Ooh, your eyes are locked in now. Hehe, that fired-up expression is kinda cool.\nThat expression gets my adrenaline pumping too!\nLet's make this as thrilling as that incredible beach live I had last time!\nBlah, blah! Come at me!",
            "audio": "resources/vo_card_cmn_04001_04001-5-uniq-0071-00_situation.acb/vo_card_cmn_04001_04001-5-uniq-0071-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Nail that! Summer Dead Beats!",
            "audio": "resources/vo_live_cmn_card_04001_04001-5-uniq-0071-00_skill-card.acb/vo_live_cmn_card_04001_04001-5-uniq-0071-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Grim Reaper Serve incoming... Huh—?! Ahaha, my bad, totally missed that...",
            "audio": "resources/vo_card_cmn_04001_04001-5-uniq-0071-00_potential-001.acb/vo_card_cmn_04001_04001-5-uniq-0071-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Hah... The training's paying off, huh? Say hello to Kakkoiiope!",
            "audio": "resources/vo_card_cmn_04001_04001-5-uniq-0071-00_potential-002.acb/vo_card_cmn_04001_04001-5-uniq-0071-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Huh, I'm actually good? Hehe, that feels great... But using compliments to catch me off guard is sneaky!",
            "audio": "resources/vo_card_cmn_04001_04001-5-uniq-0071-00_potential-003.acb/vo_card_cmn_04001_04001-5-uniq-0071-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "This is seriously such a good match...! Looks like our vibes sync up. We could be the ultimate rivals.",
            "audio": "resources/vo_card_cmn_04001_04001-5-uniq-0071-00_potential-004.acb/vo_card_cmn_04001_04001-5-uniq-0071-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Yeah, Calliope wins! How's that? Sting a little? So let's go at it again sometime. Promise!",
            "audio": "resources/vo_card_cmn_04001_04001-5-uniq-0071-00_potential-005.acb/vo_card_cmn_04001_04001-5-uniq-0071-00_potential-005.mp3"
        }
    ],
