    "voicelines": [
        {
            "type": "card_get",
            "text": "I hope my song touches each and every one of you.",
            "audio": "resources/vo_live_dial_card_06002_06002-5-uniq-0058-00_myself.acb/vo_live_dial_card_06002_06002-5-uniq-0058-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Attention you lot! We need to HYPE UP this amusement park with the power of music!\nGot it? Then while you work, I’m gonna have some fun! Laters!\nGahaha! What is this? The instrument is too small!\nToo small! Too small! *bwehs a lot*\nOkay, okay! It was just a joke! Please, don’t get mad at me...\nFinally my turn! You better keep up with me you lot!\nOtonose Kanade’s Marching Band Squad, deploy!",
            "audio": "resources/vo_card_cmn_06002_06002-5-uniq-0058-00_situation.acb/vo_card_cmn_06002_06002-5-uniq-0058-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Do-re-mi-fa-so-la-ti-do!",
            "audio": "resources/vo_live_cmn_card_06002_06002-5-uniq-0058-00_skill-card.acb/vo_live_cmn_card_06002_06002-5-uniq-0058-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Did you fell for me already? GAHAHA! Feast your eyes on me as much as you want ♪",
            "audio": "resources/vo_card_cmn_06002_06002-5-uniq-0058-00_potential-001.acb/vo_card_cmn_06002_06002-5-uniq-0058-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "I’m so hungry!! Hey, I can smell food on you! GIVE ME YOUR LUNCH!",
            "audio": "resources/vo_card_cmn_06002_06002-5-uniq-0058-00_potential-002.acb/vo_card_cmn_06002_06002-5-uniq-0058-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "You almost tripped just now, didn’t you? Pffft! I saw that perfectly~",
            "audio": "resources/vo_card_cmn_06002_06002-5-uniq-0058-00_potential-003.acb/vo_card_cmn_06002_06002-5-uniq-0058-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Music really is fun ♪ I love playing songs with everyone!",
            "audio": "resources/vo_card_cmn_06002_06002-5-uniq-0058-00_potential-004.acb/vo_card_cmn_06002_06002-5-uniq-0058-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "You know, I want to sing a song with everyone’s performace next time! Is that okay~?",
            "audio": "resources/vo_card_cmn_06002_06002-5-uniq-0058-00_potential-005.acb/vo_card_cmn_06002_06002-5-uniq-0058-00_potential-005.mp3"
        }
    ],
