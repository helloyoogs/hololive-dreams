    "voicelines": [
        {
            "type": "card_get",
            "text": "Thank you so much for giving me courage. \nI love you guys so much!",
            "audio": "resources/vo_live_dial_card_03004_03004-5-uniq-0036-00_myself.acb/vo_live_dial_card_03004_03004-5-uniq-0036-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Welcome to the Ku-ku-ku-ku-ku-ku-Kureiji Ollie's Haunted House!\nThanks for coming! Get ready for some spooky action, ghosts will jump out at you!\nDon't freak out too hard, or you might end up like me, heart on pause! Just kidding!\nThat was a zombie joke, you know? ...Huh, what's wrong? You look like you've seen a... Wait, behind me?\nWaaaaaah, is that an actual ghost?! AAAAAAAAHHHHH!!!",
            "audio": "resources/vo_card_cmn_03004_03004-5-uniq-0036-00_situation.acb/vo_card_cmn_03004_03004-5-uniq-0036-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "You guys alive out there?!",
            "audio": "resources/vo_live_cmn_card_03004_03004-5-uniq-0036-00_skill-card.acb/vo_live_cmn_card_03004_03004-5-uniq-0036-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "That's me! Kureiji Ollie, the zombie high school girl, GRRRROOOAAARRR!",
            "audio": "resources/vo_card_cmn_03004_03004-5-uniq-0036-00_potential-001.acb/vo_card_cmn_03004_03004-5-uniq-0036-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Check out this patchwork hoodie! Cute, right? What do you think??",
            "audio": "resources/vo_card_cmn_03004_03004-5-uniq-0036-00_potential-002.acb/vo_card_cmn_03004_03004-5-uniq-0036-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "This is the best! The girls' screams are just too cute♪ Building this haunted house was so worth it!",
            "audio": "resources/vo_card_cmn_03004_03004-5-uniq-0036-00_potential-003.acb/vo_card_cmn_03004_03004-5-uniq-0036-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Time to make my haunted house even better! Alright... I'm going to check out various haunted houses and learn from them!",
            "audio": "resources/vo_card_cmn_03004_03004-5-uniq-0036-00_potential-004.acb/vo_card_cmn_03004_03004-5-uniq-0036-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Gyaaaaa! This is freaking me out! I'm serious, don't leave me alone for a second!",
            "audio": "resources/vo_card_cmn_03004_03004-5-uniq-0036-00_potential-005.acb/vo_card_cmn_03004_03004-5-uniq-0036-00_potential-005.mp3"
        }
    ],
