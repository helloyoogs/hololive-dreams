    "voicelines": [
        {
            "type": "card_get",
            "text": "Thank you for all your love and support. \nLet the festivities continue!",
            "audio": "resources/vo_live_dial_card_00007_00007-5-uniq-0008-00_myself.acb/vo_live_dial_card_00007_00007-5-uniq-0008-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "You were staring at Matsuri’s dance just now, weren’t you? Have you fallen for me yet?\nYou were supposed to be cheering, but you I got you mesmerized instead! What a naughty boy you are... ♪\nAh, halftime’s about to end. I’ll head back out! Let’s give our best together ♪\nOh, and it’s completely fine if you want to keep up whatever you were doing! ♪\nIf our eyes happen to meet, I’ll give you plenty of fanservice ♪",
            "audio": "resources/vo_card_cmn_00007_00007-5-uniq-0008-00_situation.acb/vo_card_cmn_00007_00007-5-uniq-0008-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Does this mean...you want Matsuri?!",
            "audio": "resources/vo_live_cmn_card_00007_00007-5-uniq-0008-00_skill-card.acb/vo_live_cmn_card_00007_00007-5-uniq-0008-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Well, what do you think? I am so à la mode today! ♪",
            "audio": "resources/vo_card_cmn_00007_00007-5-uniq-0008-00_potential-001.acb/vo_card_cmn_00007_00007-5-uniq-0008-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "If you’re feeling down, tell me, okay? My cheers will surely boost your spirit a thousandfold ♪",
            "audio": "resources/vo_card_cmn_00007_00007-5-uniq-0008-00_potential-002.acb/vo_card_cmn_00007_00007-5-uniq-0008-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Go, go ♪ Don’t give up ♪ Don’t give up ♪ Fight onnnn! ♪",
            "audio": "resources/vo_card_cmn_00007_00007-5-uniq-0008-00_potential-003.acb/vo_card_cmn_00007_00007-5-uniq-0008-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Phew, it’s so hot~ I wonder if someone would wipe my sweat off me. *glances at you*",
            "audio": "resources/vo_card_cmn_00007_00007-5-uniq-0008-00_potential-004.acb/vo_card_cmn_00007_00007-5-uniq-0008-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "You’re cheering Matsuri on too much! Geez, I can’t help but smile back~ ♪",
            "audio": "resources/vo_card_cmn_00007_00007-5-uniq-0008-00_potential-005.acb/vo_card_cmn_00007_00007-5-uniq-0008-00_potential-005.mp3"
        }
    ],
