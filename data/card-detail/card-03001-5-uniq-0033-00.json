    "voicelines": [
        {
            "type": "card_get",
            "text": "I'm so grateful for your unwavering support. \nLet's keep our hearts connected~♪",
            "audio": "resources/vo_live_dial_card_03001_03001-5-uniq-0033-00_myself.acb/vo_live_dial_card_03001_03001-5-uniq-0033-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Hee, hee hee... Ah, here they come... They don't see me....\nOkay, now's the time. BOO!!\n...Ahyahyahya! Yay, great success!\nYou should've seen your face, it was priceless!\nAnd that funny noise you made, like \"Eep?!\"? Oh my, that was too good!\nAlright, it's your turn next! Try to surprise me!\nBut watch out, I might just turn the tables and surprise you again, tee-hee ♪",
            "audio": "resources/vo_card_cmn_03001_03001-5-uniq-0033-00_situation.acb/vo_card_cmn_03001_03001-5-uniq-0033-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Listen to my voice!",
            "audio": "resources/vo_live_cmn_card_03001_03001-5-uniq-0033-00_skill-card.acb/vo_live_cmn_card_03001_03001-5-uniq-0033-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Isn't it cute? The tail and skirt are all frilly~ Heehee~♪",
            "audio": "resources/vo_card_cmn_03001_03001-5-uniq-0033-00_potential-001.acb/vo_card_cmn_03001_03001-5-uniq-0033-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "For our next game of hide-and-seek, I'll pretend to go home as a prank... Oh, were you listening? Hehe!♪",
            "audio": "resources/vo_card_cmn_03001_03001-5-uniq-0033-00_potential-002.acb/vo_card_cmn_03001_03001-5-uniq-0033-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Here, have some water! We need to take breaks often to play our hearts out, you know ♪",
            "audio": "resources/vo_card_cmn_03001_03001-5-uniq-0033-00_potential-003.acb/vo_card_cmn_03001_03001-5-uniq-0033-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Let's play together again soon! Pinky promise, it's a deal!",
            "audio": "resources/vo_card_cmn_03001_03001-5-uniq-0033-00_potential-004.acb/vo_card_cmn_03001_03001-5-uniq-0033-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Being with you always puts a smile on my face! Thanks for everything, hehe...",
            "audio": "resources/vo_card_cmn_03001_03001-5-uniq-0033-00_potential-005.acb/vo_card_cmn_03001_03001-5-uniq-0033-00_potential-005.mp3"
        }
    ],
