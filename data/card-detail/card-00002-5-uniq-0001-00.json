    "voicelines": [
        {
            "type": "card_get",
            "text": "This moment we shared is a gift... \nThank you, from the bottom of my heart!",
            "audio": "resources/vo_live_dial_card_00002_00002-5-uniq-0001-00_myself.acb/vo_live_dial_card_00002_00002-5-uniq-0001-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Woohoo! Did you see that? Did you? I won again!\nWell, could you really expect anything else from someone as high-spec as me?\nAll right, let's keep this winning streak alive! Let's make a new Roboco legend! Woohoo!\nAre you watching? 'Cause I'm gonna show you something totally wild, hehe!\nHey, wait?! Why did the game start on its own?!\nUgh, don't do that! Oh nooo! My winning streak!",
            "audio": "resources/vo_card_cmn_00002_00002-5-uniq-0001-00_situation.acb/vo_card_cmn_00002_00002-5-uniq-0001-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Updating high-spec!",
            "audio": "resources/vo_live_cmn_card_00002_00002-5-uniq-0001-00_skill-card.acb/vo_live_cmn_card_00002_00002-5-uniq-0001-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Well? Well? Am I sexy? Am I?",
            "audio": "resources/vo_card_cmn_00002_00002-5-uniq-0001-00_potential-001.acb/vo_card_cmn_00002_00002-5-uniq-0001-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "Don't you just love my pink coat? And what could be hiding underneath... Hehe, so naughty!",
            "audio": "resources/vo_card_cmn_00002_00002-5-uniq-0001-00_potential-002.acb/vo_card_cmn_00002_00002-5-uniq-0001-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Gotta train my gaming muscles if I'm gonna set a new Roboco legend! Here we go!",
            "audio": "resources/vo_card_cmn_00002_00002-5-uniq-0001-00_potential-003.acb/vo_card_cmn_00002_00002-5-uniq-0001-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Phew, I'm pooped... Maybe a few head pats would help re-energize me... Meow!",
            "audio": "resources/vo_card_cmn_00002_00002-5-uniq-0001-00_potential-004.acb/vo_card_cmn_00002_00002-5-uniq-0001-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Thanks for always supporting me through my special training. I'll give you a head pat as thanks!",
            "audio": "resources/vo_card_cmn_00002_00002-5-uniq-0001-00_potential-005.acb/vo_card_cmn_00002_00002-5-uniq-0001-00_potential-005.mp3"
        }
    ],
