    "voicelines": [
        {
            "type": "card_get",
            "text": "Get loud, play around, and laugh along with me! \nLet's enjoy summer!",
            "audio": "resources/vo_live_dial_card_00012_00012-5-uniq-0062-00_myself.acb/vo_live_dial_card_00012_00012-5-uniq-0062-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "This is sooo nice! The seaside is the best!!!\nWhat do you want to do? I had fun floating around last time, wanna do that?\nWha...? Heeeeey! Why are you the only ones with lifesavers!\nThat is not fair! I will bring a lifesaver too! Give me a minute. Hooooaaawaaaa?!\nI think I dropped my sunglasses in the ocean?!\nDon’t be floating around like nothing is happening! Help me look for them!",
            "audio": "resources/vo_card_cmn_00012_00012-5-uniq-0062-00_situation.acb/vo_card_cmn_00012_00012-5-uniq-0062-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Don’t let the heat beat you!",
            "audio": "resources/vo_live_cmn_card_00012_00012-5-uniq-0062-00_skill-card.acb/vo_live_cmn_card_00012_00012-5-uniq-0062-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "It is really easy to move around in a swimsuit! Hehe!",
            "audio": "resources/vo_card_cmn_00012_00012-5-uniq-0062-00_potential-001.acb/vo_card_cmn_00012_00012-5-uniq-0062-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "I won't let a little water resistance beat me! Full on dash! Wooooooah!",
            "audio": "resources/vo_card_cmn_00012_00012-5-uniq-0062-00_potential-002.acb/vo_card_cmn_00012_00012-5-uniq-0062-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Break time, break time~♪ And my towel is...oh snap! I forgot my towel!",
            "audio": "resources/vo_card_cmn_00012_00012-5-uniq-0062-00_potential-003.acb/vo_card_cmn_00012_00012-5-uniq-0062-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Thank you for the towel! You really saved me! As a thank you, I will give you some shaved ice! Here!",
            "audio": "resources/vo_card_cmn_00012_00012-5-uniq-0062-00_potential-004.acb/vo_card_cmn_00012_00012-5-uniq-0062-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "The wind feels so nice~♪ Why are you staring at me like that...? I’m getting embarrassed...",
            "audio": "resources/vo_card_cmn_00012_00012-5-uniq-0062-00_potential-005.acb/vo_card_cmn_00012_00012-5-uniq-0062-00_potential-005.mp3"
        }
    ],
