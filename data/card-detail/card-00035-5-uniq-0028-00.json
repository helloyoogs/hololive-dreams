    "voicelines": [
        {
            "type": "card_get",
            "text": "This idol's gonna conquer the world! Just you wait!",
            "audio": "resources/vo_live_dial_card_00035_00035-5-uniq-0028-00_myself.acb/vo_live_dial_card_00035_00035-5-uniq-0028-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Hahahahaha!\nWe must hurry and finish the holoX World Domination Weapon, Black Schwarz!\nIf we pull this off, then the world will truly be in the hands of holoX!\nIt is I, La+ Darknesss who commands these cheers!\nLet's plan our world domination... Oh! Snack time!\nUmm... Let's come up with a strategy tomorrow!\nYou get to live another day, humans. Hahahahaha!",
            "audio": "resources/vo_card_cmn_00035_00035-5-uniq-0028-00_situation.acb/vo_card_cmn_00035_00035-5-uniq-0028-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Ready to see what I've got?",
            "audio": "resources/vo_live_cmn_card_00035_00035-5-uniq-0028-00_skill-card.acb/vo_live_cmn_card_00035_00035-5-uniq-0028-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "Have you ever seen anything as majestic as my cloak?",
            "audio": "resources/vo_card_cmn_00035_00035-5-uniq-0028-00_potential-001.acb/vo_card_cmn_00035_00035-5-uniq-0028-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "There's nothing stylish about hiding your cowlick under a hat.",
            "audio": "resources/vo_card_cmn_00035_00035-5-uniq-0028-00_potential-002.acb/vo_card_cmn_00035_00035-5-uniq-0028-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "I want to be showered with confetti when I appear on stage! That's an order!",
            "audio": "resources/vo_card_cmn_00035_00035-5-uniq-0028-00_potential-003.acb/vo_card_cmn_00035_00035-5-uniq-0028-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "Hey! Do we have a plan for world domination yet? Today's the day!",
            "audio": "resources/vo_card_cmn_00035_00035-5-uniq-0028-00_potential-004.acb/vo_card_cmn_00035_00035-5-uniq-0028-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Your commander is thirsty! Bring me something to drink!",
            "audio": "resources/vo_card_cmn_00035_00035-5-uniq-0028-00_potential-005.acb/vo_card_cmn_00035_00035-5-uniq-0028-00_potential-005.mp3"
        }
    ],
