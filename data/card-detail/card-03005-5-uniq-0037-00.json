    "voicelines": [
        {
            "type": "card_get",
            "text": "Thanks for the support, everyone! \nI'll keep doing what I do!",
            "audio": "resources/vo_live_dial_card_03005_03005-5-uniq-0037-00_myself.acb/vo_live_dial_card_03005_03005-5-uniq-0037-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Oh, hey there. Just make yourself comfortable anywhere.\nAlright, back to the game... Hmm, what's that smell? Could it be...hamburger and fries?!\nYou actually went out and bought these? You're a lifesaver!\nI was gonna be a total hermit today anyway, so this really saves me.\nAs a thank you, wanna give this game a shot? I've got a spare controller, so let's co-op this!\nCome on, don't be so tense. I'll carry us through with my amazing skills. Alright, let's do this!",
            "audio": "resources/vo_card_cmn_03005_03005-5-uniq-0037-00_situation.acb/vo_card_cmn_03005_03005-5-uniq-0037-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Behold the power of the ancients!",
            "audio": "resources/vo_live_cmn_card_03005_03005-5-uniq-0037-00_skill-card.acb/vo_live_cmn_card_03005_03005-5-uniq-0037-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "This hoodie's so comfy...it's making me drowsy...mm...hmm...? Huh! That was close.",
            "audio": "resources/vo_card_cmn_03005_03005-5-uniq-0037-00_potential-001.acb/vo_card_cmn_03005_03005-5-uniq-0037-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "So you wanna explore some ruins? Well, I guess I can tag along with you for a bit.",
            "audio": "resources/vo_card_cmn_03005_03005-5-uniq-0037-00_potential-002.acb/vo_card_cmn_03005_03005-5-uniq-0037-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "Ruins and ancient weapons, doesn't that just hit different? Right?",
            "audio": "resources/vo_card_cmn_03005_03005-5-uniq-0037-00_potential-003.acb/vo_card_cmn_03005_03005-5-uniq-0037-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "This game's no joke, one mistake and you're done for... Wait, you're actually pretty skilled. Is this seriously your first time?",
            "audio": "resources/vo_card_cmn_03005_03005-5-uniq-0037-00_potential-004.acb/vo_card_cmn_03005_03005-5-uniq-0037-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Next time let's play something different. I wanna see more of what you can do.",
            "audio": "resources/vo_card_cmn_03005_03005-5-uniq-0037-00_potential-005.acb/vo_card_cmn_03005_03005-5-uniq-0037-00_potential-005.mp3"
        }
    ],
