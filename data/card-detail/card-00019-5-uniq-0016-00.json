    "voicelines": [
        {
            "type": "card_get",
            "text": "You heard it here, folks! \nThis is the beginning of our Pekora Story!",
            "audio": "resources/vo_live_dial_card_00019_00019-5-uniq-0016-00_myself.acb/vo_live_dial_card_00019_00019-5-uniq-0016-00_myself.mp3"
        },
        {
            "type": "situation",
            "text": "Mwa ha ha ha... Complete at last, peko!\nBehold! The Pekorization is complete! As of this moment, this place shall now be known as... Pekoland 2!\nNow to pekorize the next place, and the next, and soon the entire world will belong to Peko-ra! Peeeko peko peko!\nHuh...? I'm being invoiced? You mean I gotta foot the bill?\nLet's see... HAAAHH?!?! Isn't that too many zeroes?! Waah, I'm gonna go broke!\nWhat a rip off! I've been totally screwed!",
            "audio": "resources/vo_card_cmn_00019_00019-5-uniq-0016-00_situation.acb/vo_card_cmn_00019_00019-5-uniq-0016-00_situation.mp3"
        },
        {
            "type": "skill",
            "text": "Peko-peko-peko!",
            "audio": "resources/vo_live_cmn_card_00019_00019-5-uniq-0016-00_skill-card.acb/vo_live_cmn_card_00019_00019-5-uniq-0016-00_skill-card.mp3"
        },
        {
            "type": "potential_1",
            "text": "All wrapped up in a pretty blue ribbon! Hey, aren't I just the cutest gift?",
            "audio": "resources/vo_card_cmn_00019_00019-5-uniq-0016-00_potential-001.acb/vo_card_cmn_00019_00019-5-uniq-0016-00_potential-001.mp3"
        },
        {
            "type": "potential_2",
            "text": "I've got a new rule for Pekoland... Well, just use your common sense!",
            "audio": "resources/vo_card_cmn_00019_00019-5-uniq-0016-00_potential-002.acb/vo_card_cmn_00019_00019-5-uniq-0016-00_potential-002.mp3"
        },
        {
            "type": "potential_3",
            "text": "I've got a new plan! Heehee, this is just between you and me, peko!",
            "audio": "resources/vo_card_cmn_00019_00019-5-uniq-0016-00_potential-003.acb/vo_card_cmn_00019_00019-5-uniq-0016-00_potential-003.mp3"
        },
        {
            "type": "potential_4",
            "text": "I need your help for my new plan, peko! You won't wanna miss this, I promise, peko!",
            "audio": "resources/vo_card_cmn_00019_00019-5-uniq-0016-00_potential-004.acb/vo_card_cmn_00019_00019-5-uniq-0016-00_potential-004.mp3"
        },
        {
            "type": "potential_5",
            "text": "Thank you... um... for always having my back, peko!",
            "audio": "resources/vo_card_cmn_00019_00019-5-uniq-0016-00_potential-005.acb/vo_card_cmn_00019_00019-5-uniq-0016-00_potential-005.mp3"
        }
    ],
